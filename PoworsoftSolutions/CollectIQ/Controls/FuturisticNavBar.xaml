<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CollectIQ.Controls.FuturisticNavBar"
    BackgroundColor="Transparent"
    HeightRequest="90">

    <!-- Gradient background to blend page content into the nav bar -->
    <Grid RowDefinitions="Auto"
          VerticalOptions="End">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <!-- Top: almost transparent, lets page content show through -->
                <GradientStop Color="#00050814" Offset="0.0" />
                <!-- Bottom: solid page background (#050814) -->
                <GradientStop Color="#FF050814" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Aurora-style glass pill nav -->
        <Border Style="{StaticResource AuroraGlassBorder}"
                Margin="16,0,16,0"
                Padding="18,8"
                VerticalOptions="End">

            <Grid RowDefinitions="Auto"
                  ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="28"
                  VerticalOptions="Center">

                <!-- SLOT 1 -->
                <VerticalStackLayout x:Name="Slot1Wrapper"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <!-- Icon container so we can glow the border -->
                    <Border x:Name="Slot1IconContainer"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            Background="Transparent"
                            Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Image x:Name="Slot1Icon"
                               Source="home_icon.png"
                               HeightRequest="24"
                               WidthRequest="28"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               Opacity="0.85" />
                    </Border>

                    <Label x:Name="Slot1Label"
                           Text="Home"
                           FontSize="8"
                           TextColor="#0ACAF9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- SLOT 2 -->
                <VerticalStackLayout x:Name="Slot2Wrapper"
                                     Spacing="4"
                                     Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Border x:Name="Slot2IconContainer"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            Background="Transparent"
                            Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Image x:Name="Slot2Icon"
                               Source="scan_icon.png"
                               HeightRequest="24"
                               WidthRequest="28"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               Opacity="0.85" />
                    </Border>

                    <Label x:Name="Slot2Label"
                           Text="Scan"
                           FontSize="8"
                           TextColor="#0ACAF9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- SLOT 3 -->
                <VerticalStackLayout x:Name="Slot3Wrapper"
                                     Spacing="4"
                                     Grid.Column="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Border x:Name="Slot3IconContainer"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            Background="Transparent"
                            Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Image x:Name="Slot3Icon"
                               Source="collection_icon.png"
                               HeightRequest="24"
                               WidthRequest="28"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               Opacity="0.85" />
                    </Border>

                    <Label x:Name="Slot3Label"
                           Text="Collection"
                           FontSize="8"
                           TextColor="#0ACAF9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- SLOT 4 -->
                <VerticalStackLayout x:Name="Slot4Wrapper"
                                     Spacing="4"
                                     Grid.Column="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Border x:Name="Slot4IconContainer"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            Background="Transparent"
                            Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Image x:Name="Slot4Icon"
                               Source="search_icon.png"
                               HeightRequest="24"
                               WidthRequest="28"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               Opacity="0.85" />
                    </Border>

                    <Label x:Name="Slot4Label"
                           Text="Search"
                           FontSize="8"
                           TextColor="#0ACAF9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>
    </Grid>
</ContentView>
