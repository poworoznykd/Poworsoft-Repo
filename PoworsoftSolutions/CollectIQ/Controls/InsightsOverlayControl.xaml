<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Controls.InsightsOverlayControl"
             x:Name="Root">

    <Grid>

        <!-- SCRIM -->
        <BoxView x:Name="InsightsScrim"
                 IsVisible="False"
                 Opacity="0"
                 BackgroundColor="#CC000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- GLASS PANEL -->
        <Border x:Name="InsightsOverlay"
                IsVisible="False"
                Style="{StaticResource AuroraGlassBorder}"
                BackgroundColor="#FF0B1120"
                Padding="20,18"
                Opacity="0"
                TranslationY="60"
                Margin="16"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="End">

            <!-- One scroll surface for the whole overlay -->
            <ScrollView VerticalScrollBarVisibility="Never">

                <VerticalStackLayout Spacing="16">

                    <!-- HEADER -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Market Insights"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#E2E8F0" />

                        <Image Source="close_icon.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- TITLE -->
                    <Label x:Name="InsightsTitleLabel"
                           Text="Card Title"
                           TextColor="#E2E8F0"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="0,6,0,6"
                           LineBreakMode="TailTruncation" />

                    <!-- INSIGHTS OPTIONS -->
                    <Frame BackgroundColor="#162237"
                           BorderColor="#1F2A44"
                           CornerRadius="12"
                           Padding="10"
                           Margin="0,0,0,10"
                           HasShadow="False">

                        <!-- IMPORTANT: remove the inner ScrollView to avoid nested scroll issues -->
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Use Price Guide (PriceCharting)"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Switch x:Name="UsePriceGuideSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="UsePriceGuideSwitch_Toggled" />
                            </Grid>

                            <Label x:Name="PriceGuideStatusLabel"
                                   Text="Price guide: not loaded yet"
                                   FontSize="12"
                                   TextColor="#B7D9FF" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Guide Grade Baseline"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Picker x:Name="GuideGradePicker"
                                        Grid.Column="1"
                                        WidthRequest="170"
                                        SelectedIndexChanged="GuideGradePicker_SelectedIndexChanged" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Blend with eBay Comps"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Switch x:Name="BlendEbaySwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="BlendEbaySwitch_Toggled" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Include SOLD comps"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Switch x:Name="IncludeSoldSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="IncludeSoldSwitch_Toggled" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Include ACTIVE listings"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Switch x:Name="IncludeActiveSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="IncludeActiveSwitch_Toggled" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Remove Outliers"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Switch x:Name="RemoveOutliersSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="RemoveOutliersSwitch_Toggled" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Use Current Bid For Auctions"
                                       TextColor="White"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <Switch x:Name="UseBidForAuctionsSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        Toggled="UseBidForAuctionsSwitch_Toggled" />
                            </Grid>

                            <Grid RowDefinitions="Auto,Auto">
                                <Label x:Name="EbayWeightLabel"
                                       Text="eBay Weight: 50%"
                                       TextColor="White" />
                                <Slider x:Name="EbayWeightSlider"
                                        Grid.Row="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.5"
                                        ValueChanged="EbayWeightSlider_ValueChanged" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <!-- METRIC GRID -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="4"
                          Margin="0,0,0,6">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="Listings" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsCountValue"
                                   Text="0"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#F2F6FF"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Range" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsRangeLabel"
                                   Text="$0 - $0"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#F2F6FF"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="Min" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsMinValue"
                                   Text="$0"
                                   FontSize="13"
                                   TextColor="#E2E8F0"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Max" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsMaxValue"
                                   Text="$0"
                                   FontSize="13"
                                   TextColor="#E2E8F0"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                            <Label Text="Avg" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsAvgValue"
                                   Text="$0"
                                   FontSize="13"
                                   TextColor="#E2E8F0"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="Median" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsMedianValue"
                                   Text="$0"
                                   FontSize="13"
                                   TextColor="#E2E8F0"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="3" Grid.Column="0">
                            <Label Text="Suggested" FontSize="11" TextColor="#A0AEC0"/>
                            <Label x:Name="InsightsSuggestedValue"
                                   Text="$0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#7CF9FF"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                            <Label Text="" />
                            <Label Text="" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- SUMMARY -->
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="InsightsSummaryLabel"
                               Text="No insights yet."
                               FontSize="11"
                               TextColor="#A0AEC0"
                               LineBreakMode="WordWrap" />

                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="InsightsStatsLabel"
                                   Text="Count / Avg / Min / Max"
                                   FontSize="11"
                                   TextColor="#A0AEC0" />

                            <Label x:Name="InsightsRangeLabelCard"
                                   Text="(Range / days)"
                                   FontSize="11"
                                   TextColor="#7CF9FF"
                                   HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>

                        <Label x:Name="InsightsGuideLabel"
                               Text=""
                               FontSize="11"
                               TextColor="#A0AEC0"
                               LineBreakMode="WordWrap"
                               Margin="0,6,0,0" />

                        <Label x:Name="InsightsBlendLabel"
                               Text=""
                               FontSize="11"
                               TextColor="#A0AEC0"
                               LineBreakMode="WordWrap"
                               Margin="0,0,0,6" />

                        <BoxView HeightRequest="1" BackgroundColor="#333333" />
                    </VerticalStackLayout>

                    <!-- GRAPH -->
                    <Label Text="Graph" FontAttributes="Bold" TextColor="White" Margin="0,10,0,4" />
                    <VerticalStackLayout Spacing="6">
                        <GraphicsView x:Name="InsightsGraphView" HeightRequest="190" />
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                            <Label Text="Aqua = Price Guide" FontSize="11" TextColor="#45E6FF" />
                            <Label Text="Gold = Suggested" FontSize="11" TextColor="#FFC24A" Grid.Column="1" />
                            <Label Text="Green = eBay" FontSize="11" TextColor="#80FF9A" Grid.Column="2" />
                        </Grid>
                        <FlexLayout x:Name="InsightsGraphLayout"
                                    IsVisible="False"
                                    Direction="Row"
                                    Wrap="NoWrap"
                                    JustifyContent="SpaceBetween"
                                    Margin="0,6,0,0" />
                    </VerticalStackLayout>

                    <!-- LIST -->
                    <CollectionView x:Name="InsightsListView"
                                    HeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Remove"
                                                       BackgroundColor="#8B0000"
                                                       CommandParameter="{Binding .}"
                                                       Invoked="OnRemoveCompSwipe" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Frame BackgroundColor="#141821"
                                           BorderColor="#2D3748"
                                           CornerRadius="10"
                                           Padding="8"
                                           Margin="0,4"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto">

                                            <Label Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   TextColor="#E2E8F0"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />

                                            <Label Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="{Binding SoldDateDisplay}"
                                                   TextColor="#A0AEC0"
                                                   FontSize="11" />

                                            <VerticalStackLayout Grid.Row="0"
                                                                 Grid.Column="1"
                                                                 Grid.RowSpan="2"
                                                                 Spacing="2"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                                       TextColor="#7CF9FF"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="End" />
                                                <Label Text="{Binding Status}"
                                                       TextColor="#CBD5F5"
                                                       FontSize="11"
                                                       HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Frame>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- APPLY BUTTON -->
                    <Button Text="Apply Suggested Value"
                            Style="{StaticResource AuroraNeonButton_Green}"
                            TextColor="Black"
                            CornerRadius="10"
                            Margin="0,10,0,20"
                            HeightRequest="42"
                            Clicked="ApplySuggestedValue_Clicked" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
