                    <GradientStop Color="#00E0FF" Offset="0.0" />
                    <!-- Deep aurora ocean blue -->
                    <GradientStop Color="#0077B6" Offset="0.7" />
                    <!-- Aurora ice-glow -->
                    <GradientStop Color="#80E6FFFF" Offset="1.0" />
