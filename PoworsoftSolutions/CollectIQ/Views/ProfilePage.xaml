<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CollectIQ.ViewModels"
    BackgroundColor="#020617"
    Title="Profile">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header: avatar, name, handle, badges -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border WidthRequest="80"
                        HeightRequest="80"
                        StrokeThickness="2"
                        Stroke="#38BDF8"
                        BackgroundColor="#0B1120"
                        StrokeShape="Ellipse">
                    <Image Source="{Binding AvatarPath}"
                       WidthRequest="48"
                       HeightRequest="48"
                       Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="24,24"
                         RadiusX="24"
                         RadiusY="24" />
                        </Image.Clip>
                    </Image>

                </Border>

                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding DisplayName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding Handle}"
                           FontSize="13"
                           TextColor="#9CA3AF" />
                    <HorizontalStackLayout Spacing="6">
                        <Border Padding="6,2"
                                BackgroundColor="#059669"
                                StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding IsVerified}">
                            <Label Text="Verified member"
                                   FontSize="11"
                                   TextColor="White" />
                        </Border>
                        <Border Padding="6,2"
                                BackgroundColor="#1D4ED8"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="{Binding MembershipLabel}"
                                   FontSize="11"
                                   TextColor="White" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="{Binding Location}"
                           FontSize="12"
                           TextColor="#6B7280" />
                    <Label Text="{Binding MemberSinceLabel}"
                           FontSize="11"
                           TextColor="#4B5563" />
                </VerticalStackLayout>
            </Grid>

            <!-- Reputation block -->
            <Border Stroke="#1F2937"
                    StrokeThickness="1"
                    BackgroundColor="#020617"
                    StrokeShape="RoundRectangle 18"
                    Padding="12">
                <HorizontalStackLayout Spacing="16">

                    <!-- Rating -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Reputation"
                               FontSize="12"
                               TextColor="#9CA3AF" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding StarString}"
                                   FontSize="18"
                                   TextColor="#FCD34D" />
                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                   FontSize="14"
                                   TextColor="White" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding RatingCountLabel}"
                               FontSize="11"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <!-- Quick reputation stats -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16"
                          HorizontalOptions="EndAndExpand">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Trades"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                            <Label Text="{Binding TradesCompleted}"
                                   FontSize="16"
                                   TextColor="White" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Disputes"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                            <Label Text="{Binding DisputesCount}"
                                   FontSize="16"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </HorizontalStackLayout>
            </Border>

            <!-- Collection & volume stats -->
            <Border Stroke="#1F2937"
                    StrokeThickness="1"
                    BackgroundColor="#020617"
                    StrokeShape="RoundRectangle 18"
                    Padding="12">
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Cards Owned"
                               FontSize="11"
                               TextColor="#9CA3AF" />
                        <Label Text="{Binding TotalCardsOwned}"
                               FontSize="16"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Collection Value"
                               FontSize="11"
                               TextColor="#9CA3AF" />
                        <Label Text="{Binding CollectionEstimatedValue, StringFormat='{}{0:C0}'}"
                               FontSize="16"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Volume Sold"
                               FontSize="11"
                               TextColor="#9CA3AF" />
                        <Label Text="{Binding TotalVolumeSold, StringFormat='{}{0:C0}'}"
                               FontSize="16"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Activity breakdown -->
            <Border Stroke="#1F2937"
                    StrokeThickness="1"
                    BackgroundColor="#020617"
                    StrokeShape="RoundRectangle 18"
                    Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Activity"
                           FontSize="13"
                           TextColor="#E5E7EB"
                           FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Cards Bought"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                            <Label Text="{Binding CardsBought}"
                                   FontSize="14"
                                   TextColor="White" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Cards Sold"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                            <Label Text="{Binding CardsSold}"
                                   FontSize="14"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Preferences -->
            <Border Stroke="#1F2937"
                    StrokeThickness="1"
                    BackgroundColor="#020617"
                    StrokeShape="RoundRectangle 18"
                    Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Preferences"
                           FontSize="13"
                           TextColor="#E5E7EB"
                           FontAttributes="Bold" />
                    <Label Text="{Binding FavouriteSportsLabel}"
                           FontSize="12"
                           TextColor="#D1D5DB" />
                    <Label Text="{Binding FavouriteGradersLabel}"
                           FontSize="12"
                           TextColor="#D1D5DB" />
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Border Padding="8,3"
                                BackgroundColor="#111827"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding OpenToTradesLabel}"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                        </Border>
                        <Border Padding="8,3"
                                BackgroundColor="#111827"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding ContactPreferenceLabel}"
                                   FontSize="11"
                                   TextColor="#9CA3AF" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
