<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.EbaySearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    Title="Search"
    BackgroundColor="#050814">

    <!-- 2 rows:
         0 = top mode toggle bar
         1 = main content -->
    <Grid RowDefinitions="Auto,*">

        <!-- TOP MODE TOGGLE BAR -->
        <controls:AppModeToggleBar
            Grid.Row="0"
            Margin="0,0,0,4" />

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <!-- Aurora background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#040810" Offset="0.0" />
                    <GradientStop Color="#02040A" Offset="0.5" />
                    <GradientStop Color="#020916" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- ========================= -->
            <!-- MAIN LAYOUT (ROWS)       -->
            <!-- ========================= -->
            <Grid x:Name="MainLayout"
                  RowDefinitions="*,Auto,Auto">
                <!-- Border for list of items-->
                <Border Grid.Row="0"
                 Style="{StaticResource AuroraGlassBorder}"
                 Margin="14,0,14,0">
                    <!-- RESULTS LIST -->
                    <CollectionView x:Name="EbayResultsView"
                        ItemSizingStrategy="MeasureFirstItem"
                        ItemsUpdatingScrollMode="KeepScrollOffset"
                        Grid.Row="0"
                        Margin="3,10,3,0"
                        SelectionMode="None"
                        SelectedItem="{x:Null}"
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding Listings}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView SwipeStarted="SwipeView_SwipeStarted"
                                    SwipeEnded="SwipeView_SwipeEnded">

                                    <!-- Swipe actions -->
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <!-- VIEW ON EBAY -->
                                            <SwipeItem Text="Ebay"
                                               BackgroundColor="#147d89"
                                               IconImageSource="open_link_icon.png"
                                               CommandParameter="{Binding .}"
                                               Invoked="OnViewOnEbaySwipe" />
                                            <!-- ADD TO COLLECTION -->
                                            <SwipeItem Text="Add"
                                               BackgroundColor="#14891b"
                                               IconImageSource="add_icon.png"
                                               CommandParameter="{Binding .}"
                                               Invoked="OnAddToCollectionSwipe" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <!-- RESULT CARD -->
                                    <Border Style="{StaticResource AuroraGlassBorder}"
                                        Padding="10"
                                        Margin="0,6,0,6">

                                        <!-- Selection glow -->
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                                <Setter Property="Stroke" Value="#39FF14" />
                                                <Setter Property="StrokeThickness" Value="2.5" />
                                               
                                            </DataTrigger>

                                            <DataTrigger TargetType="Border"
                                             Binding="{Binding IsSelected}"
                                             Value="False"> 
                                                <Setter Property="Stroke" Value="#00B4D8" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                             
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <!-- MAIN ROW -->
                                        <Grid ColumnDefinitions="100,*,64"
                                          ColumnSpacing="10"
                                          RowDefinitions="Auto,Auto,Auto">

                                            <!-- Tap anywhere -->
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Tapped="OnItemTapped"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <!-- IMAGE -->
                                            <Image Grid.RowSpan="3"
                                               Source="{Binding ImageUrl}"
                                               WidthRequest="96"
                                               HeightRequest="96"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />

                                            <!-- TITLE -->
                                            <Label Grid.Column="1"
                                               Text="{Binding DisplayTitle}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#F9FDFF"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2" />

                                            <!-- PRICE + EST PILL -->
                                            <VerticalStackLayout Grid.Column="1"
                                             Grid.Row="1"
                                             Spacing="2">
                                                <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#6CD4FF" />   

                                                <Grid ColumnDefinitions="Auto,Auto"
                                                    IsVisible="{Binding IsSelected}">
                                                    <Label Grid.Column="0"
                                       TextColor="AliceBlue"
                                       Text="Est. "
                                       VerticalOptions="Center"
                                       Margin="0,0,4,0" />
                                                    <Label Grid.Column="1"
                                       TextColor="AliceBlue"
                                       VerticalOptions="Center"
                                       Text="{Binding EstimatedValue, StringFormat='${0:0.00} USD'}" />
                                                </Grid>
                                            </VerticalStackLayout>

                                            <!-- STATUS -->
                                            <Label Grid.Column="1"
                               Grid.Row="2"
                               Text="{Binding Status}"
                               FontSize="12"
                               TextColor="#FFCB6B" />

                                            <!-- INSIGHTS ICON -->
                                            <Grid Grid.Column="2"
                              Grid.Row="1"
                              VerticalOptions="Center"
                              HorizontalOptions="Center">
                                                <VerticalStackLayout Spacing="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                                    <Image Source="insights_icon.png"
                                       WidthRequest="30"
                                       HeightRequest="30">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer
                                            Tapped="OnInsightsIconTapped"
                                            CommandParameter="{Binding .}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Label Text="Insights"
                                       FontSize="10"
                                       TextColor="#39FF14"
                                       HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="8,14,8,18" Spacing="8">
                                <Label Text="{Binding ResultsSummary}"
                                       IsVisible="{Binding HasMoreResults}"
                                       TextColor="#8CDCF4"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="{Binding LoadMoreButtonText}"
                                        IsVisible="{Binding HasMoreResults}"
                                        Command="{Binding LoadMoreResultsCommand}"
                                        Style="{StaticResource AuroraNeonButton}"
                                        HeightRequest="44" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>


                </Border>
                
                <!-- ========================= -->
                <!-- BOTTOM COMMAND CENTER MENU   -->
                <!-- (Hero + Status + Manual)  -->
                <!-- ========================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource AuroraGlassBorder}"
                        Margin="14,0,14,0">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="6">
                        <!-- Status ribbon (FULL WIDTH so your long status text never destroys layout) -->
                        <Border Grid.Row="0"
                                StrokeThickness="1.5"
                                Stroke="#00E5FF"
                                BackgroundColor="#101624"
                                StrokeShape="RoundRectangle 18"
                                Padding="10,6">

                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">

                                <ActivityIndicator x:Name="SearchActivityIndicator"
                                                   Color="Lime"
                                                   IsVisible="{Binding IsBusy}"
                                                   IsRunning="{Binding IsBusy}"
                                                   WidthRequest="16"
                                                   HeightRequest="16" />

                                <Label x:Name="StatusLabel"
                                       Text="{Binding StatusText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#0ACAF9"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Manual prompt (small, readable, not tall) -->
                        <Label Grid.Row="1"
                               Text="Didn’t find your card? Search manually:"
                               FontSize="11"
                               TextColor="#A8EFFF"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="Grade" TextColor="#A8EFFF" FontSize="11" VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    Stroke="#00E5FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#120A1A2A"
                                    Padding="12,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding SelectedGradeLabel}"
                                               TextColor="White"
                                               FontSize="13"
                                               FontAttributes="Bold" />
                                        <Label Text="Choose SportsCardsPro price grade"
                                               TextColor="#6CD4FF"
                                               FontSize="9" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="⌄"
                                           TextColor="#00E5FF"
                                           FontSize="22"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSearchGradeSelectorTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <!-- Entry + buttons (tight) -->
                        <Grid Grid.Row="3"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="6">

                            <Border Grid.Row="0"
                                    Stroke="#00E5FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#120A1A2A"
                                    Padding="10,6">

                                <Entry x:Name="ManualSearchBox"
                                       Placeholder="Search with eBay... Player, Year, Set"
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextColor="White"
                                       PlaceholderColor="#6CD4FF"
                                       HeightRequest="38"
                                       Keyboard="Text" />
                            </Border>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button Grid.Column="0"
                                        Text="Search"
                                        Style="{StaticResource AuroraNeonButton}"
                                        HeightRequest="40"
                                        Clicked="OnManualSearchClicked" />

                                <Button Grid.Column="1"
                                        Text="New Card"
                                        Style="{StaticResource AuroraNeonButton}"
                                        HeightRequest="40"
                                        Clicked="Add_Manual_Button_Clicked" />
                            </Grid>
                        </Grid>

                    </Grid>
                </Border>
                <Border IsVisible="{Binding IsBusy}"
                    BackgroundColor="#DD050814"
                    Stroke="#00E5FF"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 24"
                    Padding="18"
                    Margin="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">   

                    <VerticalStackLayout Spacing="12"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">

                        <ActivityIndicator Color="Lime"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           WidthRequest="42"
                           HeightRequest="42" />

                        <Label Text="Searching eBay"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F2F6FF"
                           HorizontalTextAlignment="Center" />

                        <Label Text="{Binding StatusText}"
                           FontSize="12"
                           TextColor="#6CD4FF"
                           HorizontalTextAlignment="Center"
                           MaxLines="2" />

                        <Border Stroke="#39FF14"
                            StrokeThickness="1"
                            BackgroundColor="#1839FF14"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,4">

                            <Label Text="Please wait while CollectIQ checks eBay"
                               FontSize="11"
                               TextColor="#39FF14"
                               HorizontalTextAlignment="Center" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
                <!-- NAV BAR (tight so it stays on screen) -->
                <controls:FuturisticNavBar Grid.Row="2"
                                           Margin="0,4,0,0" />
            </Grid>

            <!-- INSIGHTS OVERLAY CONTROL (kept; overlays the whole content area) -->
            <controls:InsightsOverlayControl
                Grid.Row="1"
                x:Name="InsightsOverlayControl" />

        </Grid>
    </Grid>
</ContentPage>
