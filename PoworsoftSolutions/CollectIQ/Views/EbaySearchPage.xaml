<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.EbaySearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    Title="Search"
    BackgroundColor="#050814">

    <!-- 2 rows:
         0 = top mode toggle bar
         1 = main content -->
    <Grid RowDefinitions="Auto,*">

        <!-- TOP MODE TOGGLE BAR -->
        <controls:AppModeToggleBar
            Grid.Row="0"
            Margin="0,0,0,4" />

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <!-- Aurora background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#040810" Offset="0.0" />
                    <GradientStop Color="#02040A" Offset="0.5" />
                    <GradientStop Color="#020916" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- ========================= -->
            <!-- MAIN LAYOUT (ROWS)       -->
            <!-- ========================= -->
            <!-- Goal:
                 - KEEP functionality (names + handlers).
                 - Bottom “command center” is one card and DOES NOT squeeze title (no side-by-side badge).
                 - Status is a full-width ribbon so long text never ruins layout.
                 - Tight margins/padding so nav bar stays visible. -->
            <Grid x:Name="MainLayout"
                  RowDefinitions="*,Auto,Auto"
                  Padding="0"
                  RowSpacing="6">

                <!-- RESULTS LIST -->
                <CollectionView x:Name="EbayResultsView"
                                Grid.Row="0"
                                Margin="14,10,14,0"
                                SelectionMode="None"
                                SelectedItem="{x:Null}"
                                BackgroundColor="Transparent"
                                ItemsSource="{Binding Listings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView SwipeStarted="SwipeView_SwipeStarted"
                                       SwipeEnded="SwipeView_SwipeEnded">

                                <!-- Swipe actions -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <!-- VIEW ON EBAY -->
                                        <SwipeItem Text="Ebay"
                                                   BackgroundColor="#147d89"
                                                   IconImageSource="open_link_icon.png"
                                                   CommandParameter="{Binding .}"
                                                   Invoked="OnViewOnEbaySwipe" />
                                        <!-- ADD TO COLLECTION -->
                                        <SwipeItem Text="Add"
                                                   BackgroundColor="#14891b"
                                                   IconImageSource="add_icon.png"
                                                   CommandParameter="{Binding .}"
                                                   Invoked="OnAddToCollectionSwipe" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- RESULT CARD -->
                                <Border Style="{StaticResource AuroraGlassBorder}"
                                        Padding="10"
                                        Margin="0,6,0,6">

                                    <!-- Selection glow -->
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="Stroke" Value="#39FF14" />
                                            <Setter Property="StrokeThickness" Value="2.5" />
                                            <Setter Property="Shadow">
                                                <Setter.Value>
                                                    <Shadow Brush="#39FF14"
                                                            Radius="18"
                                                            Opacity="0.85"
                                                            Offset="0,0" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsSelected}"
                                                     Value="False">
                                            <Setter Property="Stroke" Value="#00B4D8" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                            <Setter Property="Shadow">
                                                <Setter.Value>
                                                    <Shadow Brush="#00000000"
                                                            Radius="0"
                                                            Opacity="0"
                                                            Offset="0,0" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <!-- MAIN ROW -->
                                    <Grid ColumnDefinitions="100,*,64"
                                          ColumnSpacing="10"
                                          RowDefinitions="Auto,Auto,Auto">

                                        <!-- Tap anywhere -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="OnItemTapped"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <!-- IMAGE -->
                                        <Image Grid.RowSpan="3"
                                               Source="{Binding ImageUrl}"
                                               WidthRequest="96"
                                               HeightRequest="96"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />

                                        <!-- TITLE -->
                                        <Label Grid.Column="1"
                                               Text="{Binding DisplayTitle}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#F9FDFF"
                                               LineBreakMode="WordWrap"
                                               MaxLines="5" />

                                        <!-- PRICE + EST PILL -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Grid.Row="1"
                                                             Spacing="2">
                                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#6CD4FF" />

                                            <Grid ColumnDefinitions="Auto,Auto"
                                                  IsVisible="{Binding IsSelected}">
                                                <Label Grid.Column="0"
                                                       TextColor="AliceBlue"
                                                       Text="Est. "
                                                       VerticalOptions="Center"
                                                       Margin="0,0,4,0" />
                                                <Label Grid.Column="1"
                                                       TextColor="AliceBlue"
                                                       VerticalOptions="Center"
                                                       Text="{Binding EstimatedValue, StringFormat='${0:0.00} USD'}" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- STATUS -->
                                        <Label Grid.Column="1"
                                               Grid.Row="2"
                                               Text="{Binding Status}"
                                               FontSize="12"
                                               TextColor="#FFCB6B" />

                                        <!-- INSIGHTS ICON -->
                                        <Grid Grid.Column="2"
                                              Grid.Row="1"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Center">
                                            <VerticalStackLayout Spacing="2"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <Image Source="insights_icon.png"
                                                       WidthRequest="30"
                                                       HeightRequest="30">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnInsightsIconTapped"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label Text="Insights"
                                                       FontSize="10"
                                                       TextColor="#39FF14"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ========================= -->
                <!-- BOTTOM COMMAND CENTER     -->
                <!-- (Hero + Status + Manual)  -->
                <!-- ========================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource AuroraGlassBorder}"
                        Margin="14,0,14,0">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="6">

                        <!-- Title / Hero (compact, no side-by-side badge to crush layout) -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              VerticalOptions="Center">

                            <!-- Neon dot -->
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    Stroke="#00E5FF"
                                    StrokeThickness="2"
                                    BackgroundColor="#2200E5FF"
                                    StrokeShape="RoundRectangle 5"
                                    VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center">
                                <Label Text="Search with eBay"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#F2F6FF"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="Swipe results for actions • Or search manually below"
                                       FontSize="10"
                                       TextColor="#9FB3C8"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Status ribbon (FULL WIDTH so your long status text never destroys layout) -->
                        <Border Grid.Row="1"
                                StrokeThickness="1.5"
                                Stroke="#00E5FF"
                                BackgroundColor="#101624"
                                StrokeShape="RoundRectangle 18"
                                Padding="10,6">

                            <HorizontalStackLayout Spacing="8"
                                                   VerticalOptions="Center">

                                <ActivityIndicator x:Name="SearchActivityIndicator"
                                                   IsVisible="False"
                                                   IsRunning="False"
                                                   WidthRequest="16"
                                                   HeightRequest="16" />

                                <Label x:Name="StatusLabel"
                                       Text="READY"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#0ACAF9"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       HorizontalOptions="FillAndExpand" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Manual prompt (small, readable, not tall) -->
                        <Label Grid.Row="2"
                               Text="Didn’t find your card? Search manually:"
                               FontSize="11"
                               TextColor="#A8EFFF"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />

                        <!-- Entry + buttons (tight) -->
                        <Grid Grid.Row="3"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="6">

                            <Border Grid.Row="0"
                                    Stroke="#00E5FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#120A1A2A"
                                    Padding="10,6">

                                <Entry x:Name="ManualSearchBox"
                                       Placeholder="Player, year, set, card #, grade..."
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextColor="White"
                                       PlaceholderColor="#6CD4FF"
                                       HeightRequest="38"
                                       Keyboard="Text" />
                            </Border>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button Grid.Column="0"
                                        Text="Search"
                                        Style="{StaticResource AuroraNeonButton}"
                                        HeightRequest="40"
                                        Clicked="OnManualSearchClicked" />

                                <Button Grid.Column="1"
                                        Text="New Card"
                                        Style="{StaticResource AuroraNeonButton}"
                                        HeightRequest="40"
                                        Clicked="Add_Manual_Button_Clicked" />
                            </Grid>
                        </Grid>

                    </Grid>
                </Border>

                <!-- NAV BAR (tight so it stays on screen) -->
                <controls:FuturisticNavBar Grid.Row="2"
                                           Margin="0,4,0,0" />
            </Grid>

            <!-- INSIGHTS OVERLAY CONTROL (kept; overlays the whole content area) -->
            <controls:InsightsOverlayControl
                Grid.Row="1"
                x:Name="InsightsOverlayControl" />

        </Grid>
    </Grid>
</ContentPage>
