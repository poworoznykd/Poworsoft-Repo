<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Views.LandingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid>

        <!-- Aurora gradient background to match other pages -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#040810" Offset="0.0" />
                <GradientStop Color="#02040A" Offset="0.5" />
                <GradientStop Color="#020916" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- optional soft beams -->
        <Grid>
            <BoxView Opacity="0.18"
                     Rotation="15"
                     TranslationY="-260"
                     HeightRequest="220"
                     BackgroundColor="#001B33" />
            <BoxView Opacity="0.12"
                     Rotation="-12"
                     TranslationY="260"
                     HeightRequest="200"
                     BackgroundColor="#002224" />
        </Grid>

        <!-- Centered hero card -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="24"
                             Spacing="20">

            <Border Style="{StaticResource AuroraGlassBorder}"
                    Padding="22,24"
                    StrokeThickness="2.2"
                    StrokeShape="RoundRectangle 26"
                    WidthRequest="320">

                <VerticalStackLayout Spacing="18"
                                     HorizontalOptions="Center">

                    <!-- Logo + title -->
                    <Image Source="collectiq_logo.png"
                           HeightRequest="120"
                           WidthRequest="120"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="CollectIQ"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#F2F6FF"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Scan • Track • Predict • Trade"
                           FontSize="14"
                           TextColor="#9FB3C8"
                           HorizontalTextAlignment="Center" />

                    <!-- status tagline -->
                    <HorizontalStackLayout Spacing="6"
                                           HorizontalOptions="Center">
                        <BoxView WidthRequest="6"
                                 HeightRequest="6"
                                 CornerRadius="3"
                                 BackgroundColor="#39FF14"
                                 VerticalOptions="Center" />
                        <Label Text="Your collection, visually smart &amp; portable"
                               FontSize="11"
                               TextColor="#0ACAF9" />
                    </HorizontalStackLayout>

                    <!-- Buttons -->
                    <VerticalStackLayout Spacing="10"
                                         Margin="0,10,0,0">

                        <!-- Primary: Guest -->
                        <Button x:Name="EnterButton"
                                Text="Get Started (Guest)"
                                Clicked="OnGuest"
                                HeightRequest="50"
                                WidthRequest="260"
                                Style="{StaticResource AuroraNeonButton}"
                                FontAttributes="Bold" />

                        <!-- Secondary: Auth -->
                        <Button x:Name="AuthButton"
                                Text="Sign In / Register"
                                Clicked="OnAuth"
                                HeightRequest="50"
                                WidthRequest="260"
                                Style="{StaticResource AuroraNeonButton}"
                                BackgroundColor="#001020"
                                BorderColor="#00B4FF"
                                TextColor="White"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
