<?xml version="1.0" encoding="utf-8"?>
<!-- 
* FILE: ScanPage.xaml
* PROJECT: CollectIQ (Mobile Application)
* PROGRAMMER: Darryl Poworoznyk
* DESCRIPTION:
*     Neon scan experience aligned with Dashboard / Collection / Card pages.
*     Updated layout: no scrolling, scan frame always visible, floating shutter button.
-->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             x:Class="CollectIQ.Views.ScanPage"
             BackgroundColor="#050814"
             Title="Scan Card">

    <!-- 4 rows:
         0 = top mode toggle bar (Collect / Inspect / Trade)
         1 = instruction chip + scan frame (fills available height)
         2 = slim controls strip (manual + status)
         3 = bottom futuristic nav bar -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ========================= -->
        <!-- TOP MODE TOGGLE BAR       -->
        <!-- ========================= -->
        <controls:AppModeToggleBar
            Grid.Row="0"
            Margin="0,0,0,6" />

        <!-- ========================= -->
        <!-- MAIN SCAN AREA (NO SCROLL)-->
        <!-- ========================= -->
        <Grid Grid.Row="1"
              Padding="16,10,16,8"
              RowDefinitions="Auto,*"
              RowSpacing="10">

            <!-- Compact instruction chip (replaces bulky hero) -->
            <Border Grid.Row="0"
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="12,10"
                    Margin="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <!-- Minimal "dot" indicator -->
                    <Border WidthRequest="10"
                            HeightRequest="10"
                            Stroke="#00E5FF"
                            StrokeThickness="2"
                            BackgroundColor="#2200E5FF"
                            StrokeShape="RoundRectangle 5"
                            VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Align the card inside the neon frame"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#F2F6FF" />
                        <Label Text="Tap the green button to capture. Get front + back before saving."
                               FontSize="10"
                               TextColor="#9FB3C8" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Scan frame (takes all remaining height) -->
            <Border Grid.Row="1"
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="10"
                    Margin="0">

                <!-- Camera + overlays + floating shutter -->
                <Grid>

                    <!-- Live camera feed -->
                    <toolkit:CameraView
                        x:Name="CameraView"
                        BackgroundColor="Black"
                        CameraFlashMode="Off"
                        MediaCaptured="Camera_MediaCaptured" />

                    <!-- Inner neon scan frame -->
                    <Border
                        Stroke="#00E5FF"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 26"
                        BackgroundColor="#22020816"
                        Margin="14" />

                    <!-- Corner markers -->
                    <Grid Margin="20">
                        <!-- top-left -->
                        <Grid HorizontalOptions="Start"
                              VerticalOptions="Start">
                            <BoxView WidthRequest="26"
                                     HeightRequest="3"
                                     BackgroundColor="#00E5FF" />
                            <BoxView WidthRequest="3"
                                     HeightRequest="26"
                                     BackgroundColor="#00E5FF" />
                        </Grid>

                        <!-- top-right -->
                        <Grid HorizontalOptions="End"
                              VerticalOptions="Start">
                            <BoxView WidthRequest="26"
                                     HeightRequest="3"
                                     BackgroundColor="#00E5FF" />
                            <BoxView WidthRequest="3"
                                     HeightRequest="26"
                                     BackgroundColor="#00E5FF"
                                     HorizontalOptions="End" />
                        </Grid>

                        <!-- bottom-left -->
                        <Grid HorizontalOptions="Start"
                              VerticalOptions="End">
                            <BoxView WidthRequest="26"
                                     HeightRequest="3"
                                     BackgroundColor="#00E5FF"
                                     VerticalOptions="End" />
                            <BoxView WidthRequest="3"
                                     HeightRequest="26"
                                     BackgroundColor="#00E5FF" />
                        </Grid>

                        <!-- bottom-right -->
                        <Grid HorizontalOptions="End"
                              VerticalOptions="End">
                            <BoxView WidthRequest="26"
                                     HeightRequest="3"
                                     BackgroundColor="#00E5FF"
                                     VerticalOptions="End" />
                            <BoxView WidthRequest="3"
                                     HeightRequest="26"
                                     BackgroundColor="#00E5FF"
                                     HorizontalOptions="End" />
                        </Grid>
                    </Grid>

                    <!-- Animated scan line -->
                    <BoxView x:Name="ScanLine"
                             HeightRequest="3"
                             Margin="26,26,26,0"
                             VerticalOptions="Start"
                             HorizontalOptions="FillAndExpand"
                             BackgroundColor="#39FF14"
                             Opacity="0.95"
                             CornerRadius="2" />

                    <!-- Subtle bottom fade so text/buttons pop -->
                    <Border BackgroundColor="#88050814"
                            StrokeThickness="0"
                            VerticalOptions="End"
                            HeightRequest="120">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                    </Border>

                    <!-- Floating shutter button (same name + handler) -->
                    <ImageButton x:Name="ScanButton"
                                 Source="camera_icon.png"
                            Clicked="OnScanClicked"
                            BackgroundColor="Transparent"
                            Style="{StaticResource AuroraNeonRoundIconButton}"
                            BorderWidth="3"
                            WidthRequest="74"
                            HeightRequest="74"
                            CornerRadius="37"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            Margin="0,0,0,18">
                    </ImageButton>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================= -->
        <!-- FUTURISTIC NAV BAR        -->
        <!-- ========================= -->
        <controls:FuturisticNavBar
            Grid.Row="3"
            Margin="0,8,0,0" />
    </Grid>
</ContentPage>
