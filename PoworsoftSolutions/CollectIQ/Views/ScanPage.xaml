<?xml version="1.0" encoding="utf-8"?>
<!-- 
* FILE: ScanPage.xaml
* PROJECT: CollectIQ (Mobile Application)
* PROGRAMMER: Darryl Poworoznyk
* DESCRIPTION:
*     Neon scan experience aligned with Dashboard / Collection / Card pages.
-->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             x:Class="CollectIQ.Views.ScanPage"
             BackgroundColor="#050814"
             Title="Scan Card"
             Disappearing="OnDisappearing">

    <!-- 3 rows:
         0 = scrollable header + scan frame
         1 = controls (scan / manual / status)
         2 = nav bar -->
    <Grid RowDefinitions="*,Auto,Auto">

        <!-- ========================= -->
        <!-- SCROLLABLE TOP CONTENT    -->
        <!-- ========================= -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="16,16,16,8"
                Spacing="18">

                <!-- HEADER / HERO (slightly shorter) -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="14,10"
                    Margin="0,0,0,2">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Scan a Card"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#F2F6FF" />
                        <Label Text="Align the card inside the neon frame, then tap the scan button. Capture front and back before saving."
                               FontSize="10"
                               TextColor="#9FB3C8" />
                    </VerticalStackLayout>
                </Border>

                <!-- SCAN AREA: CAMERA + NEON FRAME + SCAN LINE -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="10"
                    Margin="0,4,0,12">
                    <!-- ↓↓↓ smaller so it ends well above the button ↓↓↓ -->
                    <Grid HeightRequest="320">

                        <!-- Live camera feed -->
                        <toolkit:CameraView
                            x:Name="CameraView"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand"
                            BackgroundColor="Black"
                            CameraFlashMode="Off"
                            MediaCaptured="Camera_MediaCaptured" />

                        <!-- Inner neon scan frame -->
                        <Border
                            Stroke="#00E5FF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="#22020816"
                            Margin="14" />

                        <!-- Corner markers -->
                        <Grid Margin="20">
                            <!-- top-left -->
                            <Grid HorizontalOptions="Start"
                                  VerticalOptions="Start">
                                <BoxView WidthRequest="26"
                                         HeightRequest="3"
                                         BackgroundColor="#00E5FF" />
                                <BoxView WidthRequest="3"
                                         HeightRequest="26"
                                         BackgroundColor="#00E5FF" />
                            </Grid>
                            <!-- top-right -->
                            <Grid HorizontalOptions="End"
                                  VerticalOptions="Start">
                                <BoxView WidthRequest="26"
                                         HeightRequest="3"
                                         BackgroundColor="#00E5FF" />
                                <BoxView WidthRequest="3"
                                         HeightRequest="26"
                                         BackgroundColor="#00E5FF"
                                         HorizontalOptions="End" />
                            </Grid>
                            <!-- bottom-left -->
                            <Grid HorizontalOptions="Start"
                                  VerticalOptions="End">
                                <BoxView WidthRequest="26"
                                         HeightRequest="3"
                                         BackgroundColor="#00E5FF"
                                         VerticalOptions="End" />
                                <BoxView WidthRequest="3"
                                         HeightRequest="26"
                                         BackgroundColor="#00E5FF" />
                            </Grid>
                            <!-- bottom-right -->
                            <Grid HorizontalOptions="End"
                                  VerticalOptions="End">
                                <BoxView WidthRequest="26"
                                         HeightRequest="3"
                                         BackgroundColor="#00E5FF"
                                         VerticalOptions="End" />
                                <BoxView WidthRequest="3"
                                         HeightRequest="26"
                                         BackgroundColor="#00E5FF"
                                         HorizontalOptions="End" />
                            </Grid>
                        </Grid>

                        <!-- Animated scan line -->
                        <BoxView x:Name="ScanLine"
                                 HeightRequest="3"
                                 Margin="26,26,26,0"
                                 VerticalOptions="Start"
                                 HorizontalOptions="FillAndExpand"
                                 BackgroundColor="#39FF14"
                                 Opacity="0.95"
                                 CornerRadius="2" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================= -->
        <!-- CONTROLS ROW              -->
        <!-- ========================= -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="10"
            Padding="0,0,0,6">

            <!-- Smaller neon capture button sitting clear of the frame -->
            <Button x:Name="ScanButton"
                    Style="{StaticResource AccentButtonGreen}"
                    Clicked="OnScanClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#39FF14"
                    BorderWidth="3"
                    WidthRequest="72"
                    HeightRequest="72"
                    CornerRadius="36"
                    Margin="0,4,0,0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Button.Shadow>
                    <Shadow Brush="#39FF14" Radius="22" />
                </Button.Shadow>
            </Button>

            <!-- Manual entry + status -->
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="Center"
                                   Padding="12,0">

                <!-- Match other neon buttons -->
                <Button x:Name="ManualButton"
                        Style="{StaticResource AuroraNeonButton}"
                        Text="Add Manually"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        Clicked="OnAddManuallyClicked" />

                <Label x:Name="ResultLabel"
                       Text="Ready to scan..."
                       FontSize="13"
                       TextColor="#A8EFFF"
                       HorizontalOptions="EndAndExpand"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="End" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- ========================= -->
        <!-- FUTURISTIC NAV BAR        -->
        <!-- ========================= -->
        <controls:FuturisticNavBar
            Grid.Row="2"
            Margin="0,8,0,0" />
    </Grid>
</ContentPage>
