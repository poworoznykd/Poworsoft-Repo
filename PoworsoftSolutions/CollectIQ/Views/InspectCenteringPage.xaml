<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.InspectCenteringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#050814"
    Title="Centering">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppModeToggleBar Grid.Row="0" Margin="16,8,16,4" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Margin="16,4,16,14" Spacing="12">
                <Label Text="CENTERING INSPECTOR" TextColor="#F9FAFB" FontSize="20" FontAttributes="Bold" />

                <Border Stroke="#312E81" Background="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="HOW TO USE IT" TextColor="#C4B5FD" FontSize="12" FontAttributes="Bold" />
                        <Label Text="1. Put the card flat on a plain background with all 4 edges visible." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="2. Hold the phone straight above it and fit the whole card inside the purple guide." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="3. Tap CAPTURE CARD. CollectIQ analyzes it automatically." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="4. Check the guides and scores. Use Manual Adjustments only if a detected line is wrong." TextColor="#E5E7EB" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#6D28D9" StrokeThickness="2" Background="Black" StrokeShape="RoundRectangle 22" Padding="8">
                    <Grid RowDefinitions="440,Auto" RowSpacing="8">
                        <!-- The live camera/result owns its own row. Nothing is ever drawn over
                             the captured card, so all four physical edges remain visible. -->
                        <Grid Grid.Row="0">
                            <toolkit:CameraView x:Name="CenteringCameraView" BackgroundColor="Black" CameraFlashMode="Off" />
                            <Image x:Name="CenteringResultImage"
                                   Source="{Binding CardImageSource}"
                                   Aspect="AspectFit"
                                   Margin="18"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   IsVisible="False" />

                            <Border x:Name="CenteringCameraGuide" Margin="38,34,38,34" Stroke="#C084FC" StrokeThickness="3" BackgroundColor="#08000000" StrokeShape="RoundRectangle 18" InputTransparent="True" />

                            <Label x:Name="CameraStatusLabel" Text="Starting camera…" TextColor="#FFFFFF" BackgroundColor="#C0050814" Padding="10,7" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Start" Margin="10" FontSize="12" />
                            <Button x:Name="RestartCameraButton" Text="RESTART CAMERA" Clicked="OnRestartCameraClicked" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="20" BackgroundColor="#B91C1C" TextColor="White" />
                            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#C084FC" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <!-- Capture/retake is BELOW the picture instead of hiding the bottom edge. -->
                        <Button Grid.Row="1"
                                x:Name="CenteringShutterButton"
                                Text="●  CAPTURE CARD"
                                Clicked="OnTakePhotoClicked"
                                HorizontalOptions="Center"
                                Padding="28,12"
                                CornerRadius="24"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15" />
                    </Grid>
                </Border>

                <Label x:Name="CaptureInstructionLabel" Text="Place ONE card on a plain, contrasting background. Keep all four card edges visible and avoid glare." TextColor="#C4B5FD" FontSize="12" LineBreakMode="WordWrap" />
                <Button Text="LOAD EXISTING PHOTO" Clicked="OnLoadPhotoClicked" CornerRadius="18" BackgroundColor="#312E81" TextColor="#F9FAFB" FontSize="12" />

                <Border IsVisible="{Binding HasMeasurementImage}"
                        Stroke="#0E7490"
                        StrokeThickness="2"
                        Background="#071827"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="MEASUREMENT TRANSFORM"
                                       TextColor="#67E8F9"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                                <Label Text="This is the flattened card CollectIQ actually uses for centering measurements. The full captured photo above remains unchanged."
                                       TextColor="#94A3B8"
                                       FontSize="10"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="RESET ZOOM"
                                    Clicked="OnResetMeasurementZoomClicked"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    BackgroundColor="#164E63"
                                    TextColor="White"
                                    FontSize="10" />
                        </Grid>

                        <Border Stroke="#164E63"
                                StrokeThickness="1"
                                Background="Black"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                HeightRequest="460">
                            <Grid>
                                <Image x:Name="CenteringMeasurementImage"
                                       Source="{Binding MeasurementImageSource}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill">
                                    <Image.GestureRecognizers>
                                        <PinchGestureRecognizer PinchUpdated="OnMeasurementPinchUpdated" />
                                        <PanGestureRecognizer PanUpdated="OnMeasurementPanUpdated" />
                                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                                              Tapped="OnResetMeasurementZoomTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>

                        <Label Text="Pinch to zoom up to 8× • drag while zoomed • double-tap to reset. This changes only the display, never the measurement."
                               TextColor="#A5F3FC"
                               FontSize="10"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#1F2937" Background="#0B1120" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RESULT" TextColor="#A5B4FC" FontSize="12" FontAttributes="Bold" />
                        <Label Text="{Binding StatusMessage}" TextColor="#D1FAE5" FontSize="12" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                            <Label Text="Horizontal" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Column="1" Text="{Binding HorizontalCenteringText}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                            <Label Grid.Row="1" Text="Vertical" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding VerticalCenteringText}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                            <Label Grid.Row="2" Text="Confidence" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ConfidencePercent, StringFormat='{0:0}%'}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                        </Grid>
                        <Label Text="{Binding CenteringSummary}" TextColor="#F9FAFB" FontSize="14" FontAttributes="Bold" />
                        <Label Text="{Binding Recommendation}" TextColor="#D1FAE5" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#134E4A" Background="#071A1A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MANUAL ADJUSTMENTS" TextColor="#5EEAD4" FontSize="12" FontAttributes="Bold" />
                        <Label Text="Only use this if Auto Analyze put an inner-frame line in the wrong place." TextColor="#9CA3AF" FontSize="11" />
                        <Button Text="MANUAL MODE ON / OFF" Command="{Binding ToggleManualModeCommand}" CornerRadius="18" BackgroundColor="#0F766E" TextColor="#F9FAFB" FontSize="12" />
                        <VerticalStackLayout IsVisible="{Binding IsManualMode}" Spacing="8">
                            <Label Text="Each tap moves that detected line exactly 1 pixel in the arrow direction." TextColor="#99F6E4" FontSize="11" />
                            <Grid ColumnDefinitions="58,*,76,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Label Text="Left" VerticalTextAlignment="Center" TextColor="#F9FAFB" FontSize="12" />
                                <Button Grid.Column="1" Text="◀ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Left:-1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />
                                <Label Grid.Column="2" Text="{Binding LeftAdjust, StringFormat='{0:+0;-0;0} px'}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#5EEAD4" FontSize="11" />
                                <Button Grid.Column="3" Text="1 px ▶" Command="{Binding AdjustManualLineCommand}" CommandParameter="Left:1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />

                                <Label Grid.Row="1" Text="Right" VerticalTextAlignment="Center" TextColor="#F9FAFB" FontSize="12" />
                                <Button Grid.Row="1" Grid.Column="1" Text="◀ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Right:1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding RightAdjust, StringFormat='{0:+0;-0;0} px'}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#5EEAD4" FontSize="11" />
                                <Button Grid.Row="1" Grid.Column="3" Text="1 px ▶" Command="{Binding AdjustManualLineCommand}" CommandParameter="Right:-1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />

                                <Label Grid.Row="2" Text="Top" VerticalTextAlignment="Center" TextColor="#F9FAFB" FontSize="12" />
                                <Button Grid.Row="2" Grid.Column="1" Text="▲ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Top:-1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding TopAdjust, StringFormat='{0:+0;-0;0} px'}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#5EEAD4" FontSize="11" />
                                <Button Grid.Row="2" Grid.Column="3" Text="▼ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Top:1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />

                                <Label Grid.Row="3" Text="Bottom" VerticalTextAlignment="Center" TextColor="#F9FAFB" FontSize="12" />
                                <Button Grid.Row="3" Grid.Column="1" Text="▲ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Bottom:1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding BottomAdjust, StringFormat='{0:+0;-0;0} px'}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#5EEAD4" FontSize="11" />
                                <Button Grid.Row="3" Grid.Column="3" Text="▼ 1 px" Command="{Binding AdjustManualLineCommand}" CommandParameter="Bottom:-1" IsEnabled="{Binding IsManualMode}" Padding="8,5" CornerRadius="14" BackgroundColor="#134E4A" TextColor="White" FontSize="11" />
                            </Grid>
                            <Button Text="TOGGLE ANALYSIS OVERLAY" Command="{Binding ToggleOverlayCommand}" CornerRadius="18" BackgroundColor="#4C1D95" TextColor="#E5E7EB" FontSize="12" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:FuturisticNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
