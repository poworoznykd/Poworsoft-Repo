<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.InspectCenteringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#050814"
    Title="Centering">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppModeToggleBar Grid.Row="0" Margin="16,8,16,4" />

        <ScrollView x:Name="CenteringPageScroll" Grid.Row="1">
            <VerticalStackLayout Margin="16,4,16,14" Spacing="12">
                <Label Text="CENTERING INSPECTOR" TextColor="#F9FAFB" FontSize="20" FontAttributes="Bold" />

                <Border Stroke="#312E81" Background="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="HOW TO USE IT" TextColor="#C4B5FD" FontSize="12" FontAttributes="Bold" />
                        <Label Text="1. Put the card flat on a plain background with all 4 edges visible." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="2. Hold the phone straight above it and fit the whole card inside the purple guide." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="3. Tap CAPTURE CARD. CollectIQ automatically finds, straightens and measures the card." TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="4. Review the automatic result. Only use ADJUST CENTERING if a green or yellow guide needs correction." TextColor="#E5E7EB" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#6D28D9" StrokeThickness="2" Background="Black" StrokeShape="RoundRectangle 22" Padding="8">
                    <Grid RowDefinitions="440,Auto" RowSpacing="8">
                        <!-- The live camera/result owns its own row. Nothing is ever drawn over
                             the captured card, so all four physical edges remain visible. -->
                        <Grid Grid.Row="0">
                            <toolkit:CameraView x:Name="CenteringCameraView" BackgroundColor="Black" CameraFlashMode="Off" />
                            <Image x:Name="CenteringResultImage"
                                   Source="{Binding CardImageSource}"
                                   Aspect="AspectFit"
                                   Margin="18"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   IsVisible="False" />

                            <Border x:Name="CenteringCameraGuide" Margin="38,34,38,34" Stroke="#C084FC" StrokeThickness="3" BackgroundColor="#08000000" StrokeShape="RoundRectangle 18" InputTransparent="True" />

                            <Label x:Name="CameraStatusLabel" Text="Starting camera…" TextColor="#FFFFFF" BackgroundColor="#C0050814" Padding="10,7" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Start" Margin="10" FontSize="12" />
                            <Button x:Name="RestartCameraButton" Text="RESTART CAMERA" Clicked="OnRestartCameraClicked" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="20" BackgroundColor="#B91C1C" TextColor="White" />
                            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#C084FC" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <!-- Capture/retake is BELOW the picture instead of hiding the bottom edge. -->
                        <Button Grid.Row="1"
                                x:Name="CenteringShutterButton"
                                Text="●  CAPTURE CARD"
                                Clicked="OnTakePhotoClicked"
                                HorizontalOptions="Center"
                                Padding="28,12"
                                CornerRadius="24"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15" />
                    </Grid>
                </Border>

                <Label x:Name="CaptureInstructionLabel" Text="Place ONE card on a plain, contrasting background. Keep all four card edges visible and avoid glare." TextColor="#C4B5FD" FontSize="12" LineBreakMode="WordWrap" />
                <Button Text="LOAD EXISTING PHOTO" Clicked="OnLoadPhotoClicked" CornerRadius="18" BackgroundColor="#312E81" TextColor="#F9FAFB" FontSize="12" />

                <Border IsVisible="{Binding NeedsManualOuterCard}"
                        Stroke="#22C55E"
                        StrokeThickness="2"
                        Background="#07130C"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MANUAL CARD LOCK"
                               TextColor="#86EFAC"
                               FontSize="16"
                               FontAttributes="Bold" />
                        <Label Text="Automatic outer-card detection did not finish. Move the four GREEN lines onto the TRUE OUTSIDE EDGES of the physical card. These four lines will define the rectangle CollectIQ flattens into TrueForm."
                               TextColor="#DCFCE7"
                               FontSize="11"
                               LineBreakMode="WordWrap" />

                        <Label Text="MANUAL POSITIONING: Use the four sliders below the card. The lines will move smoothly without fighting page scrolling."
                               TextColor="#BBF7D0" FontSize="12" />


                        <!-- Bound both axes. An unconstrained image can cause the Grid to
                             measure itself at the camera bitmap's huge intrinsic width,
                             placing the photo outside the phone viewport. -->
                        <Grid x:Name="ManualOuterGuideSurface"
                              WidthRequest="300"
                              HeightRequest="420"
                              HorizontalOptions="Center"
                              IsClippedToBounds="True"
                              BackgroundColor="#17212D"
                              SizeChanged="OnManualOuterGuideSurfaceSizeChanged">
                            <!-- Stretch image and guide coordinates in the same local
                                 rectangle; no letterbox/pan/zoom mismatch while editing. -->
                            <Image Source="{Binding ManualPreviewImageSource}"
                                   Aspect="Fill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   InputTransparent="True" />

                            <!-- Wide invisible touch target; the visible guide stays 2px thin. -->
                            <Grid x:Name="ManualOuterLeftGuide"
                                  WidthRequest="36" HorizontalOptions="Start" VerticalOptions="Fill"
                                  BackgroundColor="#01000000">
                                <BoxView WidthRequest="1" ScaleX="0.35" HorizontalOptions="Center" VerticalOptions="Fill"
                                         BackgroundColor="#22FF66"
                                         InputTransparent="True" />

                            </Grid>

                            <!-- Wide invisible touch target; the visible guide stays 2px thin. -->
                            <Grid x:Name="ManualOuterRightGuide"
                                  WidthRequest="36" HorizontalOptions="Start" VerticalOptions="Fill"
                                  BackgroundColor="#01000000">
                                <BoxView WidthRequest="1" ScaleX="0.35" HorizontalOptions="Center" VerticalOptions="Fill"
                                         BackgroundColor="#22FF66"
                                         InputTransparent="True" />

                            </Grid>

                            <!-- Wide invisible touch target; the visible guide stays 2px thin. -->
                            <Grid x:Name="ManualOuterTopGuide"
                                  HeightRequest="36" HorizontalOptions="Fill" VerticalOptions="Start"
                                  BackgroundColor="#01000000">
                                <BoxView HeightRequest="1" ScaleY="0.35" HorizontalOptions="Fill" VerticalOptions="Center"
                                         BackgroundColor="#22FF66"
                                         InputTransparent="True" />

                            </Grid>

                            <!-- Wide invisible touch target; the visible guide stays 2px thin. -->
                            <Grid x:Name="ManualOuterBottomGuide"
                                  HeightRequest="36" HorizontalOptions="Fill" VerticalOptions="Start"
                                  BackgroundColor="#01000000">
                                <BoxView HeightRequest="1" ScaleY="0.35" HorizontalOptions="Fill" VerticalOptions="Center"
                                         BackgroundColor="#22FF66"
                                         InputTransparent="True" />

                            </Grid>

                        </Grid>

                        <!-- Slider controls are separate from ScrollView and never zoom or resize the image. -->
                        <VerticalStackLayout Spacing="1">
                            <Label Text="LEFT EDGE" TextColor="#BBF7D0" FontSize="11" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ManualOuterLeft}"
                                    ValueChanged="OnManualOuterSliderValueChanged"
                                    AutomationId="ManualOuterLeftSlider" />
                            <Label Text="RIGHT EDGE" TextColor="#BBF7D0" FontSize="11" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ManualOuterRight}"
                                    ValueChanged="OnManualOuterSliderValueChanged"
                                    AutomationId="ManualOuterRightSlider" />
                            <Label Text="TOP EDGE" TextColor="#BBF7D0" FontSize="11" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ManualOuterTop}"
                                    ValueChanged="OnManualOuterSliderValueChanged"
                                    AutomationId="ManualOuterTopSlider" />
                            <Label Text="BOTTOM EDGE" TextColor="#BBF7D0" FontSize="11" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ManualOuterBottom}"
                                    ValueChanged="OnManualOuterSliderValueChanged"
                                    AutomationId="ManualOuterBottomSlider" />
                        </VerticalStackLayout>
                        <Label Text="These are PHYSICAL CARD edges only. Printed/image borders are measured after TrueForm is created."
                               TextColor="#BBF7D0"
                               FontSize="10"
                               LineBreakMode="WordWrap" />

                        <Button Text="CONTINUE WITH THESE CARD EDGES"
                                Clicked="OnContinueManualOuterEdgesClicked"
                                BackgroundColor="#15803D"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="52" />
                    </VerticalStackLayout>
                </Border>

                <!-- Inspection output sequence:
                     1) untouched source, 2) normalized TrueForm, 3) interactive Centering Map. -->
                <Border IsVisible="{Binding HasOriginalImage}"
                        Stroke="#7C3AED"
                        StrokeThickness="2"
                        Background="#150D24"
                        StrokeShape="RoundRectangle 16"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#A78BFA"
                                           WidthRequest="24"
                                           HeightRequest="24" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="INSPECTION STAGE"
                                   TextColor="#C4B5FD"
                                   FontSize="10"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding AnalysisStageText}"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding HasOriginalImage}"
                        Stroke="#374151"
                        StrokeThickness="1"
                        Background="#0B1120"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="1  ORIGINAL CAPTURE"
                               TextColor="#C4B5FD"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="The image exactly as it was captured. Use this to verify that CollectIQ found the correct physical card."
                               TextColor="#CBD5E1"
                               FontSize="10"
                               LineBreakMode="WordWrap" />
                        <Image Source="{Binding OriginalImageSource}"
                               Aspect="AspectFit"
                               HeightRequest="430"
                               BackgroundColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasEdgeImage}"
                        Stroke="#64748B" StrokeThickness="1"
                        Background="#0B1120" StrokeShape="RoundRectangle 18" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="2  EDGE MAP — CANNY" TextColor="#E2E8F0"
                               FontSize="14" FontAttributes="Bold" />
                        <Label Text="Physical card edges must be visible here. Card Lock is selected from the rectangle candidates, not from artwork." TextColor="#CBD5E1" FontSize="11" />
                        <Image Source="{Binding EdgeImageSource}" Aspect="AspectFit"
                               HeightRequest="420" BackgroundColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasRectangleImage}"
                        Stroke="#7C3AED" StrokeThickness="1"
                        Background="#0B1120" StrokeShape="RoundRectangle 18" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="3  RECTANGLE CANDIDATES" TextColor="#C4B5FD"
                               FontSize="14" FontAttributes="Bold" />
                        <Label Text="Purple: four-sided contour candidates. Green/yellow: selected outer rectangle and its four corners. The image remains visible even if detection fails later."
                               TextColor="#CBD5E1" FontSize="11" />
                        <Image Source="{Binding RectangleImageSource}" Aspect="AspectFit"
                               HeightRequest="420" BackgroundColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasCardLockImage}"
                        Stroke="#16A34A"
                        StrokeThickness="2"
                        Background="#07130C"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="4  CARD LOCK VIEW"
                               TextColor="#86EFAC"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="This is CollectIQ's physical-card detection checkpoint. The thick neon-green rectangle and four corner targets are the EXACT four corners that will be sent into TrueForm. They should sit directly on the real outside edges of the card."
                               TextColor="#DCFCE7"
                               FontSize="10"
                               LineBreakMode="WordWrap" />
                        <Image Source="{Binding CardLockImageSource}"
                               Aspect="AspectFit"
                               HeightRequest="430"
                               BackgroundColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasTrueFormImage}"
                        Stroke="#0E7490"
                        StrokeThickness="2"
                        Background="#071827"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="5  TRUEFORM VIEW"
                               TextColor="#67E8F9"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="TrueForm View is CollectIQ's perspective-corrected 5:7 inspection image. The detected card has been flattened and standardized so every inspection works from the same geometry."
                               TextColor="#CFFAFE"
                               FontSize="10"
                               LineBreakMode="WordWrap" />
                        <Image Source="{Binding TrueFormImageSource}"
                               Aspect="AspectFit"
                               HeightRequest="448"
                               BackgroundColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasMeasurementImage}"
                        Stroke="#0E7490"
                        StrokeThickness="2"
                        Background="#071827"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="6  CENTERING MAP"
                               TextColor="#67E8F9"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="This starts with CollectIQ's AUTOMATIC centering inspection. GREEN marks the physical card boundary. YELLOW marks the detected printed/image boundary. Review the automatic result first. Tap ADJUST CENTERING only if you want to move a guide."
                               TextColor="#E2E8F0"
                               FontSize="11"
                               LineBreakMode="WordWrap" />

                        <Grid x:Name="CenteringGuideHost"
                              HeightRequest="460"
                              HorizontalOptions="Fill"
                              SizeChanged="OnCenteringGuideHostSizeChanged">
                            <Border Stroke="#164E63"
                                    StrokeThickness="1"
                                    Background="Black"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid x:Name="CenteringGuideSurface"
                                      WidthRequest="320"
                                      HeightRequest="448"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      IsClippedToBounds="True">
                                    <Image x:Name="CenteringMeasurementImage"
                                           Source="{Binding MeasurementImageSource}"
                                           Aspect="Fill"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />

                                    <!-- GREEN: physical card rectangle -->
                                    <BoxView x:Name="OuterLeftGuide" WidthRequest="1" ScaleX="0.35" Color="#00E676" Opacity="0.95"
                                             HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                                    <BoxView x:Name="OuterRightGuide" WidthRequest="1" ScaleX="0.35" Color="#00E676" Opacity="0.95"
                                             HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                                    <BoxView x:Name="OuterTopGuide" HeightRequest="1" ScaleY="0.35" Color="#00E676" Opacity="0.95"
                                             HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                                    <BoxView x:Name="OuterBottomGuide" HeightRequest="1" ScaleY="0.35" Color="#00E676" Opacity="0.95"
                                             HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />

                                    <!-- YELLOW: printed/image rectangle -->
                                    <BoxView x:Name="InnerLeftGuide" WidthRequest="1" ScaleX="0.35" Color="#FFD60A" Opacity="0.98"
                                             HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                                    <BoxView x:Name="InnerRightGuide" WidthRequest="1" ScaleX="0.35" Color="#FFD60A" Opacity="0.98"
                                             HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                                    <BoxView x:Name="InnerTopGuide" HeightRequest="1" ScaleY="0.35" Color="#FFD60A" Opacity="0.98"
                                             HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                                    <BoxView x:Name="InnerBottomGuide" HeightRequest="1" ScaleY="0.35" Color="#FFD60A" Opacity="0.98"
                                             HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="RESTORE AUTO RESULT"
                                    Clicked="OnResetGuidesClicked"
                                    CornerRadius="16"
                                    BackgroundColor="#334155"
                                    TextColor="White"
                                    FontSize="11" />
                            <Button Grid.Column="1"
                                    Text="{Binding ManualGuideStateText}"
                                    Clicked="OnToggleGuideLockClicked"
                                    CornerRadius="16"
                                    BackgroundColor="#0F766E"
                                    TextColor="White"
                                    FontSize="10" />
                        </Grid>

                        <Label Text="Manual correction is optional. Tap ADJUST CENTERING to open the dedicated full-screen editor. The transformed card is locked in place; use the 8 sliders to move the hairline guides, then tap LOCK MANUAL LINES."
                               TextColor="#A5F3FC"
                               FontSize="10"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#1F2937" Background="#0B1120" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CENTERING RESULT — AUTOMATIC / CURRENT" TextColor="#A5B4FC" FontSize="12" FontAttributes="Bold" />
                        <Label Text="{Binding StatusMessage}" TextColor="#D1FAE5" FontSize="12" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                            <Label Text="Horizontal" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Column="1" Text="{Binding HorizontalCenteringText}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                            <Label Grid.Row="1" Text="Vertical" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding VerticalCenteringText}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                            <Label Grid.Row="2" Text="Confidence" TextColor="#A5B4FC" FontSize="12" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ConfidencePercent, StringFormat='{0:0}%'}" HorizontalTextAlignment="End" TextColor="#F9FAFB" FontSize="12" />
                        </Grid>
                        <Label Text="{Binding CenteringSummary}" TextColor="#F9FAFB" FontSize="14" FontAttributes="Bold" />
                        <Label Text="{Binding Recommendation}" TextColor="#D1FAE5" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#134E4A" Background="#071A1A" StrokeShape="RoundRectangle 16" Padding="12"
                        IsVisible="{Binding HasAnalysis}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="CENTERING METHOD" TextColor="#5EEAD4" FontSize="12" FontAttributes="Bold" />
                        <Label Text="Horizontal = left border pixels ÷ (left + right border pixels). Vertical = top border pixels ÷ (top + bottom border pixels). The values above come directly from the green/yellow guide spacing on the normalized card."
                               TextColor="#D1FAE5"
                               FontSize="10"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Dedicated manual centering editor. It fully covers the normal page,
             centers the transformed card, and uses sliders only. -->
        <Grid x:Name="ManualCenteringOverlay"
              Grid.RowSpan="3"
              ZIndex="100"
              IsVisible="False"
              BackgroundColor="#FF050814"
              Padding="12"
              RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="ADJUST CENTERING"
                       TextColor="#F9FAFB"
                       FontSize="19"
                       FontAttributes="Bold" />
                <Label Text="The TrueForm card is centered and locked. GREEN = physical card edges • YELLOW = printed/image edges. Use only the 8 sliders below."
                       TextColor="#CFFAFE"
                       FontSize="10"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="6" Padding="0,5,0,5">
                <Grid x:Name="ManualCenteringCardHost"
                      Grid.Row="0"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      SizeChanged="OnManualCenteringCardHostSizeChanged">
                    <Border Stroke="#155E75"
                            StrokeThickness="1"
                            Background="Black"
                            StrokeShape="RoundRectangle 10"
                            Padding="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Grid x:Name="ManualCenteringGuideSurface"
                              WidthRequest="260"
                              HeightRequest="364"
                              IsClippedToBounds="True"
                              SizeChanged="OnManualCenteringGuideSurfaceSizeChanged">
                            <Image Source="{Binding MeasurementImageSource}"
                                   Aspect="Fill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   InputTransparent="True" />

                            <BoxView x:Name="EditOuterLeftGuide" WidthRequest="1" ScaleX="0.35" Color="#00E676" Opacity="0.98" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                            <BoxView x:Name="EditOuterRightGuide" WidthRequest="1" ScaleX="0.35" Color="#00E676" Opacity="0.98" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                            <BoxView x:Name="EditOuterTopGuide" HeightRequest="1" ScaleY="0.35" Color="#00E676" Opacity="0.98" HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                            <BoxView x:Name="EditOuterBottomGuide" HeightRequest="1" ScaleY="0.35" Color="#00E676" Opacity="0.98" HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />

                            <BoxView x:Name="EditInnerLeftGuide" WidthRequest="1" ScaleX="0.35" Color="#FFD60A" Opacity="1" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                            <BoxView x:Name="EditInnerRightGuide" WidthRequest="1" ScaleX="0.35" Color="#FFD60A" Opacity="1" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True" />
                            <BoxView x:Name="EditInnerTopGuide" HeightRequest="1" ScaleY="0.35" Color="#FFD60A" Opacity="1" HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                            <BoxView x:Name="EditInnerBottomGuide" HeightRequest="1" ScaleY="0.35" Color="#FFD60A" Opacity="1" HorizontalOptions="Fill" VerticalOptions="Start" InputTransparent="True" />
                        </Grid>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="3">
                    <Label Text="GREEN — PHYSICAL CARD" TextColor="#86EFAC" FontSize="10" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="0"><Label Text="LEFT" TextColor="#DCFCE7" FontSize="9" /><Slider x:Name="EditOuterLeftSlider" Minimum="0" Maximum="749" AutomationId="OuterLeft" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="RIGHT" TextColor="#DCFCE7" FontSize="9" /><Slider x:Name="EditOuterRightSlider" Minimum="0" Maximum="749" AutomationId="OuterRight" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="0"><Label Text="TOP" TextColor="#DCFCE7" FontSize="9" /><Slider x:Name="EditOuterTopSlider" Minimum="0" Maximum="1049" AutomationId="OuterTop" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="BOTTOM" TextColor="#DCFCE7" FontSize="9" /><Slider x:Name="EditOuterBottomSlider" Minimum="0" Maximum="1049" AutomationId="OuterBottom" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                    </Grid>

                    <Label Text="YELLOW — PRINTED / IMAGE" TextColor="#FDE68A" FontSize="10" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="0"><Label Text="LEFT" TextColor="#FEF3C7" FontSize="9" /><Slider x:Name="EditInnerLeftSlider" Minimum="0" Maximum="749" AutomationId="InnerLeft" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="RIGHT" TextColor="#FEF3C7" FontSize="9" /><Slider x:Name="EditInnerRightSlider" Minimum="0" Maximum="749" AutomationId="InnerRight" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="0"><Label Text="TOP" TextColor="#FEF3C7" FontSize="9" /><Slider x:Name="EditInnerTopSlider" Minimum="0" Maximum="1049" AutomationId="InnerTop" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="BOTTOM" TextColor="#FEF3C7" FontSize="9" /><Slider x:Name="EditInnerBottomSlider" Minimum="0" Maximum="1049" AutomationId="InnerBottom" ValueChanged="OnManualCenteringSliderValueChanged" /></VerticalStackLayout>
                    </Grid>

                    <Border Stroke="#1E7490" Background="#082F49" StrokeShape="RoundRectangle 8" Padding="6">
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="{Binding HorizontalCenteringText}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding VerticalCenteringText}" TextColor="White" FontSize="11" HorizontalTextAlignment="End" FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
