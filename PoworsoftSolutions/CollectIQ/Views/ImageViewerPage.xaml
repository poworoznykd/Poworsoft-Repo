<?xml version="1.0" encoding="utf-8"?>
<!--
* FILE: ImageViewerPage.xaml
* PROJECT: CollectIQ (Mobile Application)
* PROGRAMMER: Darryl Poworoznyk
* FIRST VERSION: 2025-11-06
* DESCRIPTION:
*   Full-screen card viewer using FreakyZoomableView with a neon overlay mode.
*   The overlay toggle always displays a glowing outline and softly pulses
*   when active. The toggle fills neon green when ON and is transparent when OFF.
*   Includes freehand drawing overlay, color palette, and overlay save/delete.
-->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Views.ImageViewerPage"
             xmlns:freakyControls="clr-namespace:Maui.FreakyControls;assembly=Maui.FreakyControls"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False"
             Padding="0">

    <Grid x:Name="RootGrid" BackgroundColor="#000000" Opacity="0.97">

        <!-- === MAIN ZOOMABLE VIEW === -->
        <freakyControls:FreakyZoomableView>
            <Grid>
                <Image x:Name="ZoomImage"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- DRAWING OVERLAY -->
                <GraphicsView x:Name="OverlayCanvas"
                              BackgroundColor="Transparent"
                              IsVisible="False"
                              StartInteraction="OnStartInteraction"
                              DragInteraction="OnDragInteraction"
                              EndInteraction="OnEndInteraction"
                              Drawable="{x:Reference OverlayCanvas}"
                              VerticalOptions="Fill"
                              HorizontalOptions="Fill" />
            </Grid>
        </freakyControls:FreakyZoomableView>

        <!-- === TOP CONTROLS === -->
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Start"
              Padding="16"
              ColumnDefinitions="Auto,*,Auto">

            <!-- OVERLAY TOGGLE GROUP -->
            <Grid>
                <!-- Halo: always visible, pulsing when active -->
                <Ellipse x:Name="OverlayHalo"
                         WidthRequest="70"
                         HeightRequest="70"
                         Stroke="#00FF9D"
                         StrokeThickness="10"
                         Opacity="0.6"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         InputTransparent="True" />

                <!-- Outline always visible -->
                <Ellipse WidthRequest="56"
                         HeightRequest="56"
                         Stroke="#00FF9D"
                         StrokeThickness="3"
                         Opacity="1.0"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         InputTransparent="True" />

                <!-- Toggle button -->
                <Frame x:Name="OverlayToggleFrame"
                       WidthRequest="48"
                       HeightRequest="48"
                       CornerRadius="24"
                       BackgroundColor="Transparent"
                       BorderColor="Transparent"
                       HasShadow="False"
                       Padding="0"
                       VerticalOptions="Center"
                       HorizontalOptions="Center">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverlayToggleTapped" />
                    </Frame.GestureRecognizers>

                    <Image x:Name="OverlayToggleIcon"
                           Source="overlay_icon.png"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="22"
                           HeightRequest="22"
                           Opacity="0.9" />
                </Frame>
            </Grid>

            <!-- OVERLAY LABEL -->
            <Label x:Name="OverlayWatermark"
                   Text="OVERLAY"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#00FF9D"
                   Opacity="0"
                   Shadow="{Shadow Brush=#00FF9D, Radius=8, Offset='0,0'}"
                   Grid.Column="1"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,10,0,0" />

            <!-- CLOSE BUTTON -->
            <Button Text="CLOSE"
                    FontSize="16"
                    CornerRadius="20"
                    Padding="6"
                    Margin="0,4,4,0"
                    TextColor="White"
                    Style="{StaticResource AccentButton_AuroraBlue}"
                    Grid.Column="2"
                    Clicked="OnCloseClicked" />
        </Grid>

        <!-- === BOTTOM CONTROLS === -->
        <VerticalStackLayout VerticalOptions="End"
                             HorizontalOptions="Center"
                             Padding="0,0,0,25"
                             Spacing="10">

            <!-- COLOR PALETTE -->
            <Grid x:Name="ColorPalette"
                  HorizontalOptions="Center"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12">

                <Frame BackgroundColor="#FF0000" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#FF0000" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#00FF00" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent" Grid.Column="1">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#00FF00" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#00B4FF" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent" Grid.Column="2">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#00B4FF" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#8000FF" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent" Grid.Column="3">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#8000FF" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#FFFF00" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent" Grid.Column="4">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#FFFF00" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#FFA500" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                       Padding="0" BorderColor="Transparent" Grid.Column="5">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorSelected" CommandParameter="#FFA500" />
                    </Frame.GestureRecognizers>
                </Frame>
            </Grid>

            <!-- SAVE / DELETE -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="SAVE"
                        FontSize="16"
                        CornerRadius="15"
                        Padding="6"
                        TextColor="White"
                        Style="{StaticResource AccentButton_AuroraBlue}"
                        Clicked="OnSaveOverlayClicked" />

                <Button Text="DELETE"
                        FontSize="16"
                        CornerRadius="15"
                        Padding="6"
                        TextColor="White"
                        Style="{StaticResource AccentButton_AuroraBlue}"
                        Clicked="OnDeleteOverlayClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
