<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CollectIQ.Views.SurfaceInspectionResultPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#050814"
             Title="Surface Results">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,28" Spacing="14">
            <Label Text="SURFACE RESULTS" TextColor="#86FF70" FontAttributes="Bold" FontSize="13" />
            <Label Text="Directional surface map" TextColor="#F8FAFC" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SummaryLabel" TextColor="#CBD5E1" FontSize="12" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Style="{StaticResource AuroraGlassBorder}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Anomaly signal" TextColor="#9FB3C8" FontSize="10" />
                        <Label x:Name="AnomalyScoreLabel" TextColor="#F8FAFC" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Registration quality" TextColor="#9FB3C8" FontSize="10" />
                        <Label x:Name="ConsistencyLabel" TextColor="#F8FAFC" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource AuroraGlassBorder}" Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Quick inspection view" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Label x:Name="SurfaceProfileLabel" TextColor="#9FB3C8" FontSize="10" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button x:Name="HeatmapToggleButton"
                                Text="Anomalies"
                                Clicked="OnHeatmapToggleClicked"
                                BackgroundColor="#1D6A2A"
                                TextColor="#F0FFED"
                                CornerRadius="16" />
                        <Button Grid.Column="1"
                                x:Name="ReliefToggleButton"
                                Text="Relief"
                                Clicked="OnReliefToggleClicked"
                                BackgroundColor="#253047"
                                TextColor="#E2E8F0"
                                CornerRadius="16" />
                        <Button Grid.Row="1"
                                x:Name="SpecularToggleButton"
                                Text="Specular"
                                Clicked="OnSpecularToggleClicked"
                                BackgroundColor="#253047"
                                TextColor="#E2E8F0"
                                CornerRadius="16" />
                        <Button Grid.Row="1" Grid.Column="1"
                                x:Name="DiffuseToggleButton"
                                Text="Average"
                                Clicked="OnDiffuseToggleClicked"
                                BackgroundColor="#253047"
                                TextColor="#E2E8F0"
                                CornerRadius="16" />
                        <Button Grid.Row="2"
                                x:Name="AlbedoToggleButton"
                                Text="Albedo"
                                Clicked="OnAlbedoToggleClicked"
                                BackgroundColor="#253047"
                                TextColor="#E2E8F0"
                                CornerRadius="16" />
                        <Button Grid.Row="2" Grid.Column="1"
                                x:Name="DefectOverlayToggleButton"
                                Text="Detected flaws overlay"
                                Clicked="OnDefectOverlayToggleClicked"
                                BackgroundColor="#253047"
                                TextColor="#E2E8F0"
                                CornerRadius="16" />
                    </Grid>

                    <Label x:Name="PrimaryViewTitleLabel" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Label x:Name="PrimaryViewDescriptionLabel" TextColor="#64748B" FontSize="10" />
                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="8" Stroke="#39FF14">
                        <Image x:Name="PrimaryViewImage" Aspect="AspectFit" HeightRequest="500" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Label Text="Potential surface anomalies" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Label Text="Full card • automatically perspective-normalized" TextColor="#64748B" FontSize="10" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8" Stroke="#39FF14">
                <Image x:Name="HeatmapImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Label Text="Directional relief" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                <Image x:Name="ReliefImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Label Text="Specular-enhanced defect view" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Label Text="Uses the strongest off-axis highlight changes to make dents, dimples and surface waviness easier to see."
                   TextColor="#64748B"
                   FontSize="10" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                <Image x:Name="SpecularDefectImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Label Text="Glare-reduced average" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                <Image x:Name="DiffuseImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Label Text="Estimated albedo" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Label Text="Robust trimmed estimate from the neutral and four directional captures with the brightest and darkest observation rejected per pixel."
                   TextColor="#64748B" FontSize="10" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                <Image x:Name="AlbedoImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Label Text="Detected flaws overlay" TextColor="#F8FAFC" FontAttributes="Bold" />
            <Label Text="Yellow marks moderate candidates. Red marks the strongest candidates. Verify each highlighted area against the physical card."
                   TextColor="#64748B"
                   FontSize="10" />
            <Border Style="{StaticResource AuroraGlassBorder}" Padding="8" Stroke="#FFB020">
                <Image x:Name="DefectOverlayImage" Aspect="AspectFit" HeightRequest="500" />
            </Border>

            <Border Style="{StaticResource AuroraGlassBorder}" Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ALIGNMENT DIAGNOSTICS" TextColor="#86FF70" FontAttributes="Bold" FontSize="13" />
                    <Label Text="Use these views to confirm whether the four directional captures were detected, normalized and aligned correctly before trusting the anomaly heatmap."
                           TextColor="#9FB3C8"
                           FontSize="11" />

                    <Label Text="Color edge overlay" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Label Text="Top=Red • Right=Green • Bottom=Blue • Left=Yellow/Red+Green"
                           TextColor="#64748B"
                           FontSize="10" />
                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                        <Image x:Name="EdgeOverlayImage" Aspect="AspectFit" HeightRequest="360" />
                    </Border>

                    <Label Text="Alignment average" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Label Text="If alignment is good, this should look like one card instead of multiple ghosted cards."
                           TextColor="#64748B"
                           FontSize="10" />
                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="8">
                        <Image x:Name="AlignmentAverageImage" Aspect="AspectFit" HeightRequest="360" />
                    </Border>

                    <Label Text="Detected card bounds" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="TOP" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label x:Name="TopStatsLabel" TextColor="#9FB3C8" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="TopDetectionImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="RIGHT" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label x:Name="RightStatsLabel" TextColor="#9FB3C8" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="RightDetectionImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="BOTTOM" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label x:Name="BottomStatsLabel" TextColor="#9FB3C8" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="BottomDetectionImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="LEFT" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label x:Name="LeftStatsLabel" TextColor="#9FB3C8" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="LeftDetectionImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Normalized captures" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="TOP" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="TopRegisteredImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="RIGHT" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="RightRegisteredImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="BOTTOM" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="BottomRegisteredImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="LEFT" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="LeftRegisteredImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Edge maps" TextColor="#F8FAFC" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="TOP" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="TopEdgeImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="RIGHT" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="RightEdgeImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="BOTTOM" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="BottomEdgeImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="LEFT" TextColor="#F8FAFC" FontSize="10" />
                            <Border Style="{StaticResource AuroraGlassBorder}" Padding="6">
                                <Image x:Name="LeftEdgeImage" Aspect="AspectFit" HeightRequest="180" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource AuroraGlassBorder}" Padding="12">
                <Label Text="This is an inspection aid. Highlighted pixels can also be caused by foil patterns, printing, glare, card movement or inconsistent lighting. Confirm any suspected defect against the original card."
                       TextColor="#9FB3C8"
                       FontSize="11" />
            </Border>

            <Button Text="DONE"
                    Clicked="OnDoneClicked"
                    HeightRequest="50"
                    BackgroundColor="#1D6A2A"
                    TextColor="#F0FFED"
                    CornerRadius="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
