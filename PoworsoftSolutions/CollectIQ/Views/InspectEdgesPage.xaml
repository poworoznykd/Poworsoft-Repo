<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CollectIQ.Views.InspectEdgesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#050814" Title="Edges">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppModeToggleBar Grid.Row="0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">
                <Label Text="EDGE INSPECTION" TextColor="#FBBF24" FontSize="22" FontAttributes="Bold" />
                <Border Stroke="#FBBF24" StrokeThickness="1" Background="#0F172A" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="HOW TO CAPTURE" FontAttributes="Bold" TextColor="White" />
                        <Label Text="1. Put one card flat on a plain contrasting background.&#10;2. Keep the complete card and all four outer edges visible.&#10;3. Keep the phone as square to the card as practical.&#10;4. Tap CAPTURE. CollectIQ uses the same outer-card detector as Centering, rectifies the card, then analyzes only the four physical edge bands." TextColor="#CBD5E1" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Stroke="#FBBF24" StrokeThickness="2" Background="Black" StrokeShape="RoundRectangle 20" Padding="8">
                    <Grid RowDefinitions="390,Auto" RowSpacing="8">
                        <Grid>
                            <toolkit:CameraView x:Name="InspectionCameraView" BackgroundColor="Black" CameraFlashMode="Off" />
                            <Image x:Name="ResultImage"
                                   Aspect="AspectFit"
                                   Margin="18"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   IsVisible="False" />
                            <Border x:Name="CameraGuide" Margin="45,30" Stroke="#FBBF24" StrokeThickness="3" BackgroundColor="#05000000" StrokeShape="RoundRectangle 16" InputTransparent="True" />
                            <Label x:Name="CameraStatusLabel" Text="Starting camera…" TextColor="White" BackgroundColor="#C0050814" Padding="8" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Start" Margin="8" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="CaptureButton" Text="● CAPTURE" Clicked="OnCaptureClicked" BackgroundColor="#FBBF24" TextColor="White" CornerRadius="20" />
                            <Button Grid.Column="1" Text="LOAD PHOTO" Clicked="OnLoadPhotoClicked" BackgroundColor="#334155" TextColor="White" CornerRadius="20" />
                        </Grid>
                    </Grid>
                </Border>
                <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="#FBBF24" />
                <Label x:Name="SummaryLabel" Text="Capture a card to begin." TextColor="#CBD5E1" FontSize="12" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AuroraGlassBorder}" Padding="10"><VerticalStackLayout><Label Text="TOP" TextColor="White" FontAttributes="Bold"/><Label x:Name="Score1" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="10"><VerticalStackLayout><Label Text="RIGHT" TextColor="White" FontAttributes="Bold"/><Label x:Name="Score2" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AuroraGlassBorder}" Padding="10"><VerticalStackLayout><Label Text="LEFT" TextColor="White" FontAttributes="Bold"/><Label x:Name="Score3" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="10"><VerticalStackLayout><Label Text="BOTTOM" TextColor="White" FontAttributes="Bold"/><Label x:Name="Score4" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                </Grid>
                <Border Stroke="#155E75" StrokeThickness="1" Background="#071C2A" StrokeShape="RoundRectangle 16" Padding="10">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FULL CARD EDGE OVERVIEW" TextColor="#67E8F9" FontAttributes="Bold" FontSize="12" />
                        <Label Text="The entire normalized card remains visible with padding around all four physical edges. Detailed edge strips are shown below." TextColor="#94A3B8" FontSize="10" />
                        <Image x:Name="AnalysisImage" Aspect="AspectFit" MaximumHeightRequest="620" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="EXTREME EDGE CLOSEUPS" TextColor="#FBBF24" FontAttributes="Bold" FontSize="15" />
                <Border Stroke="#334155" StrokeThickness="1" Background="#0B1220" StrokeShape="RoundRectangle 12" Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="HOW TO READ THESE CLOSEUPS" TextColor="#FBBF24" FontAttributes="Bold" FontSize="11" />
                        <Label Text="Each strip is the physical outside edge of the card, not the printed design in the middle. A box appears only when the response clears the screening threshold. The explanation below tells you whether the algorithm saw whitening, roughness or a texture break and whether that combination is likely real damage or probably normal border/lighting." TextColor="#CBD5E1" FontSize="10" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AuroraGlassBorder}" Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="TOP EDGE" TextColor="White" FontAttributes="Bold" />
                        <Image x:Name="TopEdgeCloseupImage" Aspect="AspectFit" MaximumHeightRequest="260" />
                        <Label x:Name="TopEdgeExplanationLabel" Text="" TextColor="#CBD5E1" FontSize="10" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource AuroraGlassBorder}" Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="RIGHT EDGE" TextColor="White" FontAttributes="Bold" />
                        <Image x:Name="RightEdgeCloseupImage" Aspect="AspectFit" MaximumHeightRequest="420" />
                        <Label x:Name="RightEdgeExplanationLabel" Text="" TextColor="#CBD5E1" FontSize="10" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource AuroraGlassBorder}" Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="BOTTOM EDGE" TextColor="White" FontAttributes="Bold" />
                        <Image x:Name="BottomEdgeCloseupImage" Aspect="AspectFit" MaximumHeightRequest="260" />
                        <Label x:Name="BottomEdgeExplanationLabel" Text="" TextColor="#CBD5E1" FontSize="10" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource AuroraGlassBorder}" Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="LEFT EDGE" TextColor="White" FontAttributes="Bold" />
                        <Image x:Name="LeftEdgeCloseupImage" Aspect="AspectFit" MaximumHeightRequest="420" />
                        <Label x:Name="LeftEdgeExplanationLabel" Text="" TextColor="#CBD5E1" FontSize="10" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="These are machine-vision screening scores, not a final grade. Confirm suspected whitening, chipping, fraying, rounding or roughness against the physical card." TextColor="#94A3B8" FontSize="10" />
            </VerticalStackLayout>
        </ScrollView>
        <controls:FuturisticNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
