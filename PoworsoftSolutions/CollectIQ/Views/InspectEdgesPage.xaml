<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CollectIQ.Views.InspectEdgesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             BackgroundColor="#050814"
             Title="Edges">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppModeToggleBar Grid.Row="0" />
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="12" VerticalOptions="Center">
            <Label Text="EDGE INSPECTION" TextColor="#FBBF24" FontSize="22" FontAttributes="Bold" />
            <Label Text="Dedicated edge inspection will live here. Chipping, whitening, roughness and edge damage will be analyzed independently before any future combined condition model."
                   TextColor="#CBD5E1" />
            <Label Text="Planned as an independent module." TextColor="#9FB3C8" FontSize="12" />
        </VerticalStackLayout>
        <controls:FuturisticNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
