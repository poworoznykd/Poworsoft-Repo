<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CollectIQ.Views.InspectEdgesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#050814"
             Title="Edges">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppModeToggleBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">
                <Label Text="EDGE INSPECTION"
                       TextColor="#FBBF24"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Border Stroke="#FBBF24" StrokeThickness="1" Background="#0F172A" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ONE EDGE AT A TIME" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Choose TOP, RIGHT, BOTTOM or LEFT. Move close enough that the physical edge fills most of the frame, keep a little background visible outside the card, place the physical edge anywhere inside the thick yellow guide band, with BACKGROUND on one side and CARD on the other, then capture. The thin yellow line marks the ideal center, but the edge does not need to be pixel-perfect. CollectIQ first locks the true physical boundary. It will not grade an edge when that boundary cannot be found reliably."
                               TextColor="#CBD5E1" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button x:Name="TopEdgeButton" Text="TOP" CommandParameter="Top" Clicked="OnEdgeSelected" CornerRadius="14" BackgroundColor="#F59E0B" TextColor="White" FontSize="10" />
                    <Button x:Name="RightEdgeButton" Grid.Column="1" Text="RIGHT" CommandParameter="Right" Clicked="OnEdgeSelected" CornerRadius="14" BackgroundColor="#334155" TextColor="White" FontSize="10" />
                    <Button x:Name="BottomEdgeButton" Grid.Column="2" Text="BOTTOM" CommandParameter="Bottom" Clicked="OnEdgeSelected" CornerRadius="14" BackgroundColor="#334155" TextColor="White" FontSize="10" />
                    <Button x:Name="LeftEdgeButton" Grid.Column="3" Text="LEFT" CommandParameter="Left" Clicked="OnEdgeSelected" CornerRadius="14" BackgroundColor="#334155" TextColor="White" FontSize="10" />
                </Grid>

                <Label x:Name="SelectedEdgeLabel"
                       Text="Inspecting TOP edge"
                       TextColor="#FDE68A"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Border x:Name="CapturePanel" Stroke="#FBBF24" StrokeThickness="2" Background="Black" StrokeShape="RoundRectangle 20" Padding="8">
                    <Grid RowDefinitions="390,Auto" RowSpacing="8">
                        <Grid>
                            <toolkit:CameraView x:Name="InspectionCameraView" BackgroundColor="Black" CameraFlashMode="Off" />
                            <Image x:Name="ResultImage" Aspect="AspectFit" Margin="12" HorizontalOptions="Fill" VerticalOptions="Fill" IsVisible="False" />

                            <Grid x:Name="CameraGuide" InputTransparent="True">
                                <BoxView x:Name="GuideBand"
                                         Color="#20FBBF24"
                                         WidthRequest="285"
                                         HeightRequest="18"
                                         CornerRadius="5"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                                <BoxView x:Name="GuideCenterLine"
                                         Color="#FFFBBF24"
                                         WidthRequest="285"
                                         HeightRequest="2"
                                         CornerRadius="1"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                                <Label x:Name="GuideOutsideLabel"
                                       Text="BACKGROUND"
                                       TextColor="#FDE68A"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TranslationY="-35" />
                                <Label x:Name="GuideCardLabel"
                                       Text="CARD"
                                       TextColor="#FFFFFF"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TranslationY="35" />
                            </Grid>

                            <Label x:Name="CameraStatusLabel"
                                   Text="Starting camera…"
                                   TextColor="White"
                                   BackgroundColor="#C0050814"
                                   Padding="8"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Start"
                                   Margin="8" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="CaptureButton" Text="● CAPTURE" Clicked="OnCaptureClicked" BackgroundColor="#FBBF24" TextColor="White" CornerRadius="20" />
                            <Button Grid.Column="1" Text="LOAD PHOTO" Clicked="OnLoadPhotoClicked" BackgroundColor="#334155" TextColor="White" CornerRadius="20" />
                        </Grid>
                    </Grid>
                </Border>

                <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="#FBBF24" />
                <Label x:Name="SummaryLabel" Text="Choose an edge and capture a close-up." TextColor="#CBD5E1" FontSize="12" LineBreakMode="WordWrap" />

                <Border x:Name="ResultPanel" IsVisible="False" Stroke="#155E75" StrokeThickness="1" Background="#071C2A" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout>
                                <Label Text="EDGE CONDITION" TextColor="#67E8F9" FontAttributes="Bold" FontSize="12" />
                                <Label x:Name="OverallScoreLabel" Text="—" TextColor="White" FontSize="28" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label x:Name="GeometryConfidenceLabel" Text="Geometry —" TextColor="#86EFAC" FontSize="11" HorizontalTextAlignment="End" />
                                <Label x:Name="CaptureQualityLabel" Text="Quality —" TextColor="#CBD5E1" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <Image x:Name="AnalysisImage" Aspect="AspectFit" MaximumHeightRequest="430" />
                        <Label Text="The green trace is the physical edge CollectIQ actually graded. If it does not follow the real card edge, retake instead of trusting the score." TextColor="#94A3B8" FontSize="10" LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="STRAIGHTNESS" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="StraightnessScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="WHITENING / CHIPPING" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="WhiteningScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="FRAYING / ROUGHNESS" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="FrayingScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="DENTS / NICKS" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="NickScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="MISSING MATERIAL" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="MissingScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="9"><VerticalStackLayout><Label Text="DEFORMATION" TextColor="White" FontSize="10" FontAttributes="Bold"/><Label x:Name="DeformationScoreLabel" Text="—" TextColor="#CBD5E1"/></VerticalStackLayout></Border>
                        </Grid>

                        <Label x:Name="ResultExplanationLabel" Text="" TextColor="#CBD5E1" FontSize="11" LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="RETAKE THIS EDGE" Clicked="OnRetakeClicked" BackgroundColor="#334155" TextColor="White" CornerRadius="16" />
                            <Button Grid.Column="1" Text="NEXT EDGE" Clicked="OnNextEdgeClicked" BackgroundColor="#15803D" TextColor="White" CornerRadius="16" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#334155" StrokeThickness="1" Background="#0B1220" StrokeShape="RoundRectangle 14" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="THIS SESSION" TextColor="#FBBF24" FontAttributes="Bold" FontSize="11" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Label x:Name="TopSessionLabel" Text="TOP —" TextColor="#CBD5E1" FontSize="10" HorizontalTextAlignment="Center" />
                            <Label x:Name="RightSessionLabel" Grid.Column="1" Text="RIGHT —" TextColor="#CBD5E1" FontSize="10" HorizontalTextAlignment="Center" />
                            <Label x:Name="BottomSessionLabel" Grid.Column="2" Text="BOTTOM —" TextColor="#CBD5E1" FontSize="10" HorizontalTextAlignment="Center" />
                            <Label x:Name="LeftSessionLabel" Grid.Column="3" Text="LEFT —" TextColor="#CBD5E1" FontSize="10" HorizontalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="These are machine-vision screening scores, not a professional grading-company grade. Confirm suspected damage against the physical card." TextColor="#94A3B8" FontSize="10" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:FuturisticNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
