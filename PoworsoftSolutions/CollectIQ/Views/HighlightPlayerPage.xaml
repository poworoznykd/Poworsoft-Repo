<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.HighlightPlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Highlight Reel">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="#050814">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Style="{StaticResource AuroraGlassBorder}"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <!-- Back button -->
                <Button Text="Back"
                        Style="{StaticResource AuroraNeonButton}"
                        Padding="12,4"
                        Clicked="OnBackClicked" />

                <!-- Title / card name -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Highlight Control Room"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#F2F6FF" />
                    <Label x:Name="CardNameLabel"
                           FontSize="13"
                           TextColor="#E2E8F0"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24"
                                 Spacing="16">

                <!-- MAIN CONTROL AREA -->
                <Border Style="{StaticResource AuroraGlassBorder}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="12"
                          Padding="10,10,10,12">

                        <!-- PSEUDO PLAYER SURFACE -->
                        <Grid Grid.Row="0"
      x:Name="PlayerSurface"
      HeightRequest="220">

                            <!-- Gesture recognizer MUST be before or after the child elements -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaySurfaceTapped" />
                            </Grid.GestureRecognizers>

                            <Image x:Name="ThumbnailImage"
           Aspect="AspectFill"
           Opacity="0.95" />

                            <!-- dark overlay -->
                            <Grid BackgroundColor="#66000000" />

                            <!-- center overlay: big play hint -->
                            <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="6">
                                <Label Text="▶"
               FontSize="40"
               TextColor="#F2F6FF"
               HorizontalTextAlignment="Center" />
                                <Label Text="Tap to play on YouTube"
               TextColor="#E2E8F0"
               FontSize="12"
               HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- left/right nav arrows -->
                            <Button Text="‹"
            FontSize="22"
            BackgroundColor="#66000000"
            TextColor="#F2F6FF"
            CornerRadius="20"
            Padding="6,0"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Clicked="OnPrevClipClicked" />

                            <Button Text="›"
            FontSize="22"
            BackgroundColor="#66000000"
            TextColor="#F2F6FF"
            CornerRadius="20"
            Padding="6,0"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Clicked="OnNextClipClicked" />
                        </Grid>


                        <!-- CARD + CLIP INFO -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <!-- left side: subtitle + clip text -->
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <Label x:Name="CardSubtitleLabel"
                                       FontSize="12"
                                       TextColor="#A0AEC0"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label x:Name="ClipDescriptionLabel"
                                       FontSize="13"
                                       TextColor="#F2F6FF"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- right side: badge block -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Grade:"
                                           FontSize="11"
                                           TextColor="#A0AEC0" />
                                    <Label x:Name="GradeLabel"
                                           FontSize="12"
                                           TextColor="#E2E8F0" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Est:"
                                           FontSize="11"
                                           TextColor="#A0AEC0" />
                                    <Label x:Name="EstimatedValueLabel"
                                           FontSize="12"
                                           TextColor="#E2E8F0" />
                                </HorizontalStackLayout>
                                <Label x:Name="ClipPositionLabel"
                                       FontSize="11"
                                       TextColor="#A0AEC0"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ACTION BAR (PLAY / COPY / SHARE as neon icon buttons) -->
                        <Grid Grid.Row="2"
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="24"
                            HorizontalOptions="Center">

                            <!-- ICON ROW -->
                            <ImageButton Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource AuroraNeonRoundIconButton}"
                                Source="play_icon.png"
                                Clicked="OnPlayClicked" />

                            <ImageButton Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource AuroraNeonRoundIconButton}"
                                Source="open_link_icon.png"
                                Clicked="OnCopyLinkClicked" />

                            <ImageButton Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource AuroraNeonRoundIconButton}"
                                Source="share_icon.png"
                                Clicked="OnShareClicked" />

                            <!-- LABEL ROW -->
                            <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Play"
                               FontSize="11"
                               TextColor="#E2E8F0"
                               HorizontalTextAlignment="Center" />

                            <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="Copy"
                               FontSize="11"
                               TextColor="#E2E8F0"
                               HorizontalTextAlignment="Center" />

                            <Label Grid.Row="1"
                               Grid.Column="2"
                               Text="Share"
                               FontSize="11"
                               TextColor="#E2E8F0"
                               HorizontalTextAlignment="Center" />
                        </Grid>

                    </Grid>
                </Border>

                <!-- CLIP STRIP -->
                <Border Style="{StaticResource AuroraGlassBorder}">
                    <VerticalStackLayout Padding="8,6"
                                         Spacing="6">
                        <Label Text="Highlight Clips"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#F2F6FF" />
                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout x:Name="ClipStripLayout"
                                                   Spacing="8"
                                                   Padding="0,4,0,4" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
