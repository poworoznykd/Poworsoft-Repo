<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Views.AuthSheet"
             Shell.NavBarIsVisible="True"
             Shell.TitleColor="#0ab8f9"
             Shell.BackgroundColor="{StaticResource OffBlack}"
             BackgroundColor="{StaticResource OffBlack}"
             xmlns:vm="clr-namespace:CollectIQ.ViewModels.Auth"
             x:DataType="vm:LoginViewModel">

    <Grid Padding="0">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#020610" Offset="0.0" />
                <GradientStop Color="#021520" Offset="0.35" />
                <GradientStop Color="#042f49" Offset="0.75" />
                <GradientStop Color="#0ab8f9" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout
                Spacing="18"
                Padding="18,20,18,24"
                VerticalOptions="Start"
                HorizontalOptions="FillAndExpand">
                <!-- STATUS MESSAGE -->
                <Label
                    Text="{Binding Message}"
                    FontSize="14"
                    TextColor="#39FF14"
                    HorizontalOptions="Center"
                    Margin="0,0,0,4" /> 

                <!-- HERO CARD -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 26"
                    Padding="18,16"
                    Margin="0,0,0,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="CollectIQ Account"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF" />

                        <Label Text="Create an account or sign in to sync your collection and save your scans."
                               FontSize="13"
                               TextColor="#E0F5FF" />

                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     BackgroundColor="#39FF14"
                                     VerticalOptions="Center" />
                            <Label Text="Secure cloud backup for your cards"
                                   FontSize="13"
                                   TextColor="#39FF14" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- MAIN FORM CARD -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 26"
                    Padding="18,16"
                    Margin="0,0,0,8">

                    <Grid RowSpacing="10"
                          ColumnDefinitions="*"
                          RowDefinitions="
                                Auto,  
                                Auto,  
                                12,
                                Auto,   
                                Auto,   
                                Auto,   
                                16,
                                Auto,   
                                Auto,   
                                Auto,   
                                20,
                                Auto,   
                                Auto,
                                16,
                                Auto,
                                Auto,
                                Auto">
                        <!-- 12 Sign In -->

                        <!-- EMAIL -->
                        <Label Grid.Row="0"
                               Text="Email"
                               FontSize="14"
                               TextColor="#E0F5FF" />

                        <Entry
                            Grid.Row="1"
                            Placeholder="you@example.com"
                            PlaceholderColor="#7A8CA0"
                            TextColor="White"
                            Keyboard="Email"
                            HeightRequest="44"
                            BackgroundColor="#10141B"
                            Margin="0,2,0,0"
                            Text="{Binding Email}" />

                        <!-- PASSWORD -->
                        <Label Grid.Row="3"
                               Text="Password"
                               FontSize="14"
                               TextColor="#E0F5FF"
                               Margin="0,4,0,0" />

                        <Grid Grid.Row="4"
      ColumnDefinitions="*,40"
      HeightRequest="44"
      BackgroundColor="#10141B"
      Margin="0,2,0,0">

                            <Entry
                                Grid.Column="0"
                                Text="{Binding Password}"
                                Placeholder="Password"
                                PlaceholderColor="#7A8CA0"
                                TextColor="White"
                                IsPassword="{Binding IsPasswordHidden}"
                                BackgroundColor="Transparent" />

                            <ImageButton
                                Grid.Column="1"
                                Source="{Binding PasswordEyeIcon}"
                                BackgroundColor="Transparent"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Padding="6"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- STRENGTH METER -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <VerticalStackLayout Spacing="6">

                                <!-- LABEL -->
                                <Label
                                    Text="{Binding Strength, Converter={StaticResource StrengthToLabelConverter}}"
                                    FontSize="13"
                                    TextColor="#E0F5FF"
                                    HorizontalOptions="Start" />

                                <!-- BARS -->
                                <Grid ColumnDefinitions="*,*,*" HeightRequest="8">

                                    <BoxView
                                        Grid.Column="0"
                                        CornerRadius="4"
                                        BackgroundColor="{Binding Strength, Converter={StaticResource WeakColorConverter}}" />

                                    <BoxView
                                        Grid.Column="1"
                                        CornerRadius="4"
                                        BackgroundColor="{Binding Strength, Converter={StaticResource MediumColorConverter}}" />

                                    <BoxView
                                        Grid.Column="2"
                                        CornerRadius="4"
                                        BackgroundColor="{Binding Strength, Converter={StaticResource StrongColorConverter}}" />

                                </Grid>
                            </VerticalStackLayout>
                        </Grid>


                        <!-- CONFIRM -->
                        <Label Grid.Row="7"
                               Text="Confirm password"
                               FontSize="14"
                               TextColor="#E0F5FF"
                               Margin="0,6,0,0" />

                        <Entry
                            Grid.Row="8"
                            Placeholder="Re-enter password"
                            PlaceholderColor="#7A8CA0"
                            TextColor="White"
                            IsPassword="True"
                            HeightRequest="44"
                            BackgroundColor="#10141B"
                            Margin="0,2,0,0"
                            Text="{Binding ConfirmPassword}" />

                        <!-- REMEMBER ME -->
                        <HorizontalStackLayout Grid.Row="9"
                                               Spacing="8"
                                               VerticalOptions="Center"
                                               Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding RememberMe}"
                                      Color="#39FF14" />
                            <Label Text="Remember me"
                                   TextColor="#E0F5FF"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- CREATE ACCOUNT -->
                        <Button
                            Grid.Row="11"
                            Style="{StaticResource AuroraNeonButton}"
                            Text="Create account"
                            Command="{Binding RegisterCommand}"
                            HeightRequest="50"
                            Margin="0,6,0,4" />

                        <!-- SIGN IN -->
                        <Button
                            Grid.Row="12"
                            Style="{StaticResource AuroraNeonButton}"
                            Text="Sign in"
                            Command="{Binding LoginCommand}"
                            HeightRequest="50" />

                        <!-- SOCIAL / GUEST -->
                        <Label
                            Grid.Row="14"
                            Text="Or continue with"
                            FontSize="13"
                            TextColor="#B9C6D4"
                            HorizontalOptions="Center" />

                        <HorizontalStackLayout
                            Grid.Row="15"
                            Grid.ColumnSpan="2"
                            Spacing="10"
                            HorizontalOptions="Center">
                            <ImageButton
                                Clicked="GoogleLoginButton_Clicked"
                                HeightRequest="60"
                                WidthRequest="160"
                                CornerRadius="12"
                                Source="google_sign_in.png"
                                Aspect="AspectFill"
                                Style="{StaticResource AuroraNeonRoundIconButton}"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button
                            Grid.Row="16"
                            Text="Continue as Guest"
                            Command="{Binding GuestLoginCommand}"
                            HeightRequest="44"
                            CornerRadius="12"
                            BackgroundColor="#10141B"
                            BorderColor="#2A3646"
                            BorderWidth="1"
                            TextColor="#E0F5FF" />

                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
