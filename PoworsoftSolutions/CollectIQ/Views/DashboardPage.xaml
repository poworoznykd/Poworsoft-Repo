<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#0E141A">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header Section -->
            <Label Text="Collect IQ"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#00B4D8"
                   HorizontalOptions="Center" />

            <!-- Card Statistics Section -->
            <Frame CornerRadius="12"
                   Padding="20"
                   BackgroundColor="#14181C"
                   BorderColor="#00B4D8"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="20">

                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Cards Owned"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#AAAAAA" />
                        <Label Text="{Binding CardsOwned}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6CD4FF"
                               HorizontalOptions="Start" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Collection Value"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#AAAAAA" />
                        <Label Text="{Binding CollectionValue, StringFormat='${0:N2}'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6CD4FF"
                               HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Divider -->
            <BoxView HeightRequest="1"
                     Color="#333333"
                     Margin="0,10" />

            <!-- Action Buttons Section -->
            <VerticalStackLayout Spacing="16" Margin="0,10,0,0">

                <Button Text="Scan New Card"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding ScanCardCommand}"
                        BackgroundColor="#00B4D8"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="55" />

                <Button Text="Compare on eBay"
                        Command="{Binding EbayCompareCommand}"
                        Style="{StaticResource AccentButtonGreen}"
                        BackgroundColor="#0078D7"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="55" />

                <Button Text="View My Collection"
                        Command="{Binding ViewCollectionCommand}"
                        Style="{StaticResource AccentButton}"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="55" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
