<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:controls="clr-namespace:CollectIQ.Views.Controls"
             x:Class="CollectIQ.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#0E141A">
    <Grid RowDefinitions="Auto,Auto,*,Auto,80" Padding="0" RowSpacing="15">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24" Spacing="20">

                <!-- Header Section -->
                <Label Text="DASHBOARD"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#00B4D8"
               HorizontalOptions="Center" />

                <!-- Card Statistics Section -->
                <Frame CornerRadius="12"
               Padding="20"
               BackgroundColor="#14181C"
               BorderColor="#00B4D8"
               HasShadow="True">
                    <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="20">

                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Cards Owned"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#AAAAAA" />
                            <Label Text="{Binding CardsOwned}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#6CD4FF"
                           HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Collection Value"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#AAAAAA" />
                            <Label Text="{Binding CollectionValue, StringFormat='${0:N2}'}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#6CD4FF"
                           HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                 Color="#333333"
                 Margin="0,10" />


               
            </VerticalStackLayout>

        </ScrollView>
        <controls:FuturisticNavBar Grid.Row="4" Margin="0,12,0,0"/>
    </Grid>
    
</ContentPage>
