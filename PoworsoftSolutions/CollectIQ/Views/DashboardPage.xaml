<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Views.Controls"
    Title="Dashboard">

    <Grid RowDefinitions="*,Auto">

        <!-- ========================= -->
        <!-- FUTURISTIC BACKGROUND     -->
        <!-- ========================= -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#040810" Offset="0.0" />
                <GradientStop Color="#02040A" Offset="0.5" />
                <GradientStop Color="#020916" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- soft teal beams -->
        <Grid>
            <BoxView Opacity="0.16"
                     Rotation="15"
                     TranslationY="-260"
                     HeightRequest="220"
                     BackgroundColor="#001B33" />
            <BoxView Opacity="0.12"
                     Rotation="-12"
                     TranslationY="260"
                     HeightRequest="200"
                     BackgroundColor="#002224" />
        </Grid>

        <!-- ========================= -->
        <!-- MAIN SCROLL CONTENT       -->
        <!-- ========================= -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="18,24,18,20"
                Spacing="22">

                <!-- ========================= -->
                <!-- MY COLLECTION HERO CARD   -->
                <!-- ========================= -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    StrokeThickness="2.2"
                    StrokeShape="RoundRectangle 26"
                    Padding="18,16"
                    Background="#050914"
                    Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto">

                        <!-- LEFT: TEXT + STATS -->
                        <VerticalStackLayout Grid.Column="0"
                                             Grid.RowSpan="4"
                                             Spacing="10">

                            <Label Text="My Collection"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#F9FDFF" />

                            <Label Text="{Binding LastUpdatedLabel}"
                                   FontSize="11"
                                   TextColor="#0ACAF9" />

                            <!-- card + value row -->
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <!-- Cards owned -->
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="CARDS OWNED"
                                           FontSize="10"
                                           TextColor="#0ACAF9" />
                                    <Label Text="{Binding CardsOwned}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF" />
                                </VerticalStackLayout>

                                <!-- Estimated value -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     Margin="18,0,0,0">
                                    <Label Text="EST. VALUE"
                                           FontSize="10"
                                           TextColor="#0ACAF9" />
                                    <!-- slightly smaller so it never clips -->
                                    <Label Text="{Binding CollectionValue, StringFormat='${0:N2}'}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#39FF14" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- status line -->
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         CornerRadius="3"
                                         BackgroundColor="#39FF14"
                                         VerticalOptions="Center" />
                                <Label Text="Card matrix online · tracking your collection value"
                                       FontSize="11"
                                       TextColor="#9FB3C8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- RIGHT: NEON CHIP -->
                        <Grid Grid.Column="1"
                              Grid.RowSpan="4"
                              Margin="12,0,0,0"
                              VerticalOptions="Center">

                            <!-- faint drop plate -->
                            <Border Stroke="#050B16"
                                    Background="#020611"
                                    StrokeShape="RoundRectangle 18"
                                    TranslationX="11"
                                    TranslationY="11"
                                    Opacity="0.7"
                                    WidthRequest="82"
                                    HeightRequest="112" />

                            <!-- glowing chip -->
                            <Border StrokeShape="RoundRectangle 18"
                                    WidthRequest="82"
                                    HeightRequest="112"
                                    Style="{StaticResource AuroraGlassBorder}">

                                <VerticalStackLayout
                                    Padding="6"
                                    Spacing="4"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Label Text="COLLECT"
                                           FontSize="10"
                                           TextColor="#0ACAF9"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="IQ"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="#39FF14"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="PROFILE"
                                           FontSize="10"
                                           TextColor="#0ACAF9"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================= -->
                <!-- COLLECTION INSIGHTS       -->
                <!-- ========================= -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Collection Insights"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F9FDFF" />

                    <HorizontalStackLayout Spacing="12">

                        <!-- Avg Value / Card -->
                        <Border
                            Stroke="#39FF14"
                            StrokeThickness="1.7"
                            Background="#05131F"
                            StrokeShape="RoundRectangle 18"
                            Padding="12"
                            Style="{StaticResource AuroraGlassBorder}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Avg Value / Card"
                                       FontSize="11"
                                       TextColor="#8FD7FF" />
                                <Label Text="{Binding AverageCardValue, StringFormat='${0:N2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#39FF14" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Highest value placeholder -->
                        <Border
                            Stroke="#0ACAF9"
                            StrokeThickness="1.7"
                            Background="#050C1C"
                            StrokeShape="RoundRectangle 18"
                            Padding="12"
                            Style="{StaticResource AuroraGlassBorder}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Highest Recorded Value"
                                       FontSize="11"
                                       TextColor="#0ACAF9" />
                                <Label Text="Coming soon"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0ACAF9" />
                            </VerticalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- small spacer -->
                <BoxView HeightRequest="4" Opacity="0" />

                <!-- ========================= -->
                <!-- DEALS BY SPORT            -->
                <!-- ========================= -->
                <VerticalStackLayout Spacing="8" Margin="0,4,0,32">
                    <Label Text="Deals by Sport"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F9FDFF" />

                    <Label Text="Tap a sport to jump into active eBay deals for that lane."
                           FontSize="11"
                           TextColor="#0ACAF9" />

                    <!-- SPORT STRIP NEAR BOTTOM -->
                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="12" Padding="0,10,0,4">

                            <!-- Helper pattern:
                                 Each tile uses same teal/blue palette so logos feel uniform. -->

                            <!-- NFL -->
                            <Border Stroke="#00E5FF"
                                    StrokeThickness="1.8"
                                    Background="#04101B"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NFL" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">

                                    <!-- embossed logo plate -->
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="nfl_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NFL"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Quarterback and receiver targets"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- NBA -->
                            <Border Stroke="#00B4FF"
                                    StrokeThickness="1.8"
                                    Background="#040F1A"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NBA" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="nbs_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NBA"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Rookies and silver parallels"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- NHL -->
                            <Border Stroke="#00E5FF"
                                    StrokeThickness="1.8"
                                    Background="#040F19"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NHL" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="nhl_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NHL"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Young Guns and key prospects"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- MLB -->
                            <Border Stroke="#00B4FF"
                                    StrokeThickness="1.8"
                                    Background="#040F1A"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="MLB" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="mlb_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="MLB"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Prospects and flagship runs"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- NCAA -->
                            <Border Stroke="#00E5FF"
                                    StrokeThickness="1.8"
                                    Background="#041119"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NCAA" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="ncaa_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NCAA"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="College rookies and stars"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- WNBA -->
                            <Border Stroke="#00B4FF"
                                    StrokeThickness="1.8"
                                    Background="#041019"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="WNBA" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="wnba_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="WNBA"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Breakout names to stash"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- PGA / Golf -->
                            <Border Stroke="#00E5FF"
                                    StrokeThickness="1.8"
                                    Background="#041218"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="10"
                                    WidthRequest="132"
                                    Style="{StaticResource AuroraGlassBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="PGA" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border Stroke="#0B2A3F"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="pga_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="Golf"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Tour legends and majors"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FUTURISTIC NAV BAR (UNCHANGED) -->
        <controls:FuturisticNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
