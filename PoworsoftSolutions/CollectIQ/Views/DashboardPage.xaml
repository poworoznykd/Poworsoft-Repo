<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    Title="Dashboard"
    BackgroundColor="#050814">

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN SCROLL CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="16,18,16,12"
                Spacing="22">

                <!-- ========================= -->
                <!-- HERO: MY COLLECTION OVERVIEW -->
                <!-- ========================= -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="16,14"
                    Margin="0,0,0,10">

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12">

                        <!-- LEFT SIDE: TITLE + STATS -->
                        <VerticalStackLayout Grid.Column="0"
                                             Grid.RowSpan="3"
                                             Spacing="8">
                            <Label Text="My Collection"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#F2F6FF" />

                            <Label Text="{Binding LastUpdatedLabel}"
                                   FontSize="11"
                                   TextColor="#0ACAF9" />

                            <!-- Cards + Total value -->
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  Margin="0,4,0,0">

                                <!-- Cards owned -->
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="CARDS OWNED"
                                           FontSize="10"
                                           TextColor="#7CF9FF" />
                                    <Label Text="{Binding CardsOwned}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF" />
                                </VerticalStackLayout>

                                <!-- Estimated value -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="EST. VALUE"
                                           FontSize="10"
                                           TextColor="#7CF9FF" />
                                    <Label Text="{Binding CollectionValue, StringFormat='${0:N2}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#39FF14" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Status line -->
                            <HorizontalStackLayout Spacing="6"
                                                   Margin="0,6,0,0">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         CornerRadius="3"
                                         BackgroundColor="#39FF14"
                                         VerticalOptions="Center" />
                                <Label Text="Tracking your collection value in real time."
                                       FontSize="11"
                                       TextColor="#9FB3C8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- RIGHT SIDE: COLLECTIQ CHIP (fixed) -->
                        <Grid Grid.Column="1"
                              Grid.RowSpan="3"
                              Margin="10,4,4,4"
                              VerticalOptions="Center">

                            <!-- Single clean glass chip -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                    WidthRequest="86"
                                    HeightRequest="110"
                                    Padding="6,8">

                                <VerticalStackLayout
                                    Spacing="3"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Label Text="COLLECT"
                                           FontSize="9"
                                           TextColor="#0ACAF9"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1"
                                           HorizontalTextAlignment="Center" />

                                    <Label Text="IQ"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#39FF14"
                                           HorizontalTextAlignment="Center" />

                                    <Label Text="PROFILE"
                                           FontSize="9"
                                           TextColor="#0ACAF9"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================= -->
                <!-- COLLECTION INSIGHTS PANEL -->
                <!-- ========================= -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="14,12"
                    Margin="0,0,0,10">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Collection Insights"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#F2F6FF" />

                        <!-- Avg value per card -->
                        <Border
                            Style="{StaticResource AuroraGlassBorder}"
                            Padding="10,8"
                            Margin="0,0,0,6">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Avg value per card"
                                       FontSize="11"
                                       TextColor="#8FD7FF" />
                                <Label Text="{Binding AverageCardValue, StringFormat='${0:N2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#39FF14" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Best lane placeholder -->
                        <Border
                            Style="{StaticResource AuroraGlassBorder}"
                            Padding="10,8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Best performing lane"
                                       FontSize="11"
                                       TextColor="#8FD7FF" />
                                <Label Text="Coming soon"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0ACAF9" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Soon you'll see which sports, sets, or grades are driving your gains."
                               FontSize="11"
                               TextColor="#9FB3C8" />
                    </VerticalStackLayout>
                </Border>

                <!-- ========================= -->
                <!-- DEALS BY SPORT STRIP      -->
                <!-- ========================= -->
                <VerticalStackLayout Spacing="8"
                                     Margin="0,0,0,24">
                    <Label Text="Deals by Sport"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#F2F6FF" />

                    <Label Text="Tap a lane to jump into curated eBay deals."
                           FontSize="11"
                           TextColor="#0ACAF9" />

                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="12"
                                               Padding="0,10,0,4">

                            <!-- NFL -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                    Padding="10"
                                    WidthRequest="132">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NFL" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                     HorizontalOptions="Center">
                                    <Border StrokeThickness="0"
                                            Background="White"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="6"
                                            WidthRequest="96"
                                            HeightRequest="52">
                                        <Image Source="nfl_logo.png"
                                               Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NFL"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="QB / WR / RB targets"
                                           FontSize="10"
                                           TextColor="#9FB3C8"
                                           HorizontalTextAlignment="Center"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- NBA -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                    Padding="10"
                                    WidthRequest="132">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSportDealsTapped"
                                        CommandParameter="NBA" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                    <Border StrokeThickness="0"
                                        Background="White"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6"
                                        WidthRequest="96"
                                        HeightRequest="52">
                                        <!-- use your existing asset name -->
                                        <Image Source="nbs_logo.png"
                                           Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NBA"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="Center" />
                                    <Label Text="Rookies and silvers"
                                       FontSize="10"
                                       TextColor="#9FB3C8"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- NHL -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                Padding="10"
                                WidthRequest="132">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                    Tapped="OnSportDealsTapped"
                                    CommandParameter="NHL" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                    <Border StrokeThickness="0"
                                        Background="White"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6"
                                        WidthRequest="96"
                                        HeightRequest="52">
                                        <Image Source="nhl_logo.png"
                                           Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="NHL"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="Center" />
                                    <Label Text="Young Guns &amp; prospects"
                                       FontSize="10"
                                       TextColor="#9FB3C8"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- MLB -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                Padding="10"
                                WidthRequest="132">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                    Tapped="OnSportDealsTapped"
                                    CommandParameter="MLB" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                    <Border StrokeThickness="0"
                                        Background="White"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6"
                                        WidthRequest="96"
                                        HeightRequest="52">
                                        <Image Source="mlb_logo.png"
                                           Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="MLB"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="Center" />
                                    <Label Text="Prospects &amp; flagships"
                                       FontSize="10"
                                       TextColor="#9FB3C8"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Pokémon -->
                            <Border Style="{StaticResource AuroraGlassBorder}"
                                Padding="10"
                                WidthRequest="132">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                    Tapped="OnSportDealsTapped"
                                    CommandParameter="Pokemon" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center">
                                    <Border StrokeThickness="0"
                                        Background="White"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6"
                                        WidthRequest="96"
                                        HeightRequest="52">
                                        <Image Source="pokemon_logo.png"
                                           Aspect="AspectFit" />
                                    </Border>

                                    <Label Text="Pokémon"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="Center" />
                                    <Label Text="Chase cards &amp; grails"
                                       FontSize="10"
                                       TextColor="#9FB3C8"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- SHARED FUTURISTIC NAV BAR -->
        <controls:FuturisticNavBar Grid.Row="1" />

    </Grid>
</ContentPage>
