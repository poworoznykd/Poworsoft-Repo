<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.DashboardPage"
    x:Name="DashboardRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CollectIQ.Controls"
    Title="Dashboard"
    BackgroundColor="#050814">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:AppModeToggleBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,18,16,12"
                Spacing="22">

                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="16,14"
                    Margin="0,0,0,10">

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12">

                        <!-- LEFT SIDE -->
                        <VerticalStackLayout Grid.Column="0"
                                             Grid.RowSpan="3"
                                             Spacing="8">
                            <Label Text="My Collection"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#F2F6FF" />

                            <Label Text="{Binding LastUpdatedLabel}"
                                   FontSize="11"
                                   TextColor="#0ACAF9" />

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  Margin="0,4,0,0">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="CARDS OWNED"
                                           FontSize="10"
                                           TextColor="#7CF9FF" />
                                    <Label Text="{Binding CardsOwned}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="EST. VALUE"
                                           FontSize="10"
                                           TextColor="#7CF9FF" />
                                    <Label Text="{Binding CollectionValue, StringFormat='${0:N2}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#39FF14" />
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="6"
                                                   Margin="0,6,0,0">
                                <BoxView WidthRequest="6"
                                         HeightRequest="6"
                                         CornerRadius="3"
                                         BackgroundColor="#39FF14"
                                         VerticalOptions="Center" />
                                <Label Text="Tracking your collection value in real time."
                                       FontSize="11"
                                       TextColor="#9FB3C8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- RIGHT SIDE: AVATAR CHIP ONLY -->
                        <Grid Grid.Column="1"
                              Grid.RowSpan="3"
                              Margin="10,4,4,4"
                              VerticalOptions="Center">

                            <Border Style="{StaticResource AuroraGlassBorder}"
                                    WidthRequest="86"
                                    HeightRequest="110"
                                    Padding="6,8">

                                <Grid>

                                    <!-- Avatar -->
                                    <Border StrokeThickness="1"
                                            Stroke="#334155"
                                            Background="#0B1220"
                                            StrokeShape="RoundRectangle 18"
                                            Padding="0">

                                        <Grid>
                                            <Image
                                                x:Name="DashboardAvatarImage"
                                                Aspect="AspectFill"
                                                Opacity="0.96"
                                                Source="{Binding Profile.AvatarPath}" />

                                            <!-- small overlay hint -->
                                            <VerticalStackLayout
                                                Spacing="2"
                                                VerticalOptions="End"
                                                Padding="6,6"
                                                Background="#66000000">
                                                <Label
                                                    Text="Profile"
                                                    FontSize="10"
                                                    TextColor="#E2E8F0" />
                                                <Label
                                                    Text="Tap"
                                                    FontSize="9"
                                                    TextColor="#A0AEC0" />
                                            </VerticalStackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnProfileAvatarTapped" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

                <!-- (rest of your dashboard unchanged below) -->

                <!-- COLLECTION INSIGHTS PANEL -->
                <Border
                    Style="{StaticResource AuroraGlassBorder}"
                    Padding="14,12"
                    Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Collection Insights"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#F2F6FF" />

                        <Border
                            Style="{StaticResource AuroraGlassBorder}"
                            Padding="10,8"
                            Margin="0,0,0,6">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Avg value per card"
                                       FontSize="11"
                                       TextColor="#8FD7FF" />
                                <Label Text="{Binding AverageCardValue, StringFormat='${0:N2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#39FF14" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Style="{StaticResource AuroraGlassBorder}"
                            Padding="10,8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Best performing lane"
                                       FontSize="11"
                                       TextColor="#8FD7FF" />
                                <Label Text="Coming soon"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0ACAF9" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Soon you'll see which sports, sets, or grades are driving your gains."
                               FontSize="11"
                               TextColor="#9FB3C8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Deals by Sport etc... keep your existing content here -->

            </VerticalStackLayout>
        </ScrollView>

        <controls:FuturisticNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
