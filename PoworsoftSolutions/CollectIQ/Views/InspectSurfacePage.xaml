<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectIQ.Views.InspectSurfacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#050814"
    Title="Surface Inspection">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="Auto,*">
            <Button Text="‹"
                    Clicked="OnBackClicked"
                    WidthRequest="44"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="#172033"
                    TextColor="#F8FAFC" />
            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="1">
                <Label Text="SURFACE INSPECTION"
                       TextColor="#86FF70"
                       FontAttributes="Bold"
                       FontSize="14" />
                <Label x:Name="HeaderStatusLabel"
                       Text="Directional light capture"
                       TextColor="#9FB3C8"
                       FontSize="11" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Setup panel shown before capture begins. -->
            <ScrollView x:Name="SetupPanel">
                <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
                    <Label Text="Reveal what normal lighting can hide"
                           TextColor="#F8FAFC"
                           FontSize="24"
                           FontAttributes="Bold" />
                    <Label Text="Keep the card still and make sure all four physical edges stay visible. First capture a neutral reference image; CollectIQ uses that image to establish the physical card geometry, then relocates those same four sides in each directional-light capture before perspective correction and fine alignment."
                           TextColor="#CBD5E1"
                           FontSize="12" />

                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="14" Stroke="#39FF14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="RECOMMENDED: EXTERNAL LIGHT"
                                       TextColor="#86FF70"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="MVP" TextColor="#39FF14" FontSize="10" />
                            </Grid>
                            <Label Text="Use another phone flashlight, small LED, or movable desk light. The first image is captured with the directional light moved away under normal room lighting. Then keep the card fixed while the light moves to Top, Right, Bottom and Left. You can hand-hold the camera and normal movement is expected."
                                   TextColor="#CBD5E1" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="14" Opacity="0.65">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="PHONE ONLY: REFLECTION SWEEP (EXPERIMENTAL)"
                                   TextColor="#C084FC"
                                   FontAttributes="Bold" />
                            <Label Text="A future mode will test moving the phone/flash or rotating the card and then registering the images. It stays experimental until we can prove repeatability across phones and foil finishes."
                                   TextColor="#CBD5E1" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="14">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Before you start" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label Text="• Remove sleeves/top loaders when safe.&#10;• Use a flat MATTE BLACK or MATTE WHITE background.&#10;• Fit the entire card inside the green guide as well as you can; no physical card edge may be outside the camera image.&#10;• The card does NOT need to be perfectly parallel to the phone.&#10;• Keep the card itself fixed; normal handheld phone movement is expected.&#10;• Keep the external light at roughly the same distance for all four images."
                                   TextColor="#9FB3C8" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AuroraGlassBorder}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Card surface profile" TextColor="#F8FAFC" FontAttributes="Bold" />
                            <Label Text="Choose Normal for standard paper/chrome-light cards. Choose Foil/Chrome when strong reflective finishes need more aggressive specular tuning."
                                   TextColor="#9FB3C8"
                                   FontSize="11" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource AuroraGlassBorder}" Padding="10" Stroke="#2A334A">
                                    <VerticalStackLayout Spacing="4">
                                        <RadioButton x:Name="NormalSurfaceProfileRadio"
                                                     Content="Normal card"
                                                     GroupName="SurfaceProfile"
                                                     IsChecked="True"
                                                     CheckedChanged="OnSurfaceProfileChanged" />
                                        <Label Text="Balanced tuning for regular paper cards and less reflective finishes."
                                               TextColor="#64748B"
                                               FontSize="10" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource AuroraGlassBorder}" Padding="10" Stroke="#2A334A">
                                    <VerticalStackLayout Spacing="4">
                                        <RadioButton x:Name="FoilChromeSurfaceProfileRadio"
                                                     Content="Foil / chrome"
                                                     GroupName="SurfaceProfile"
                                                     CheckedChanged="OnSurfaceProfileChanged" />
                                        <Label Text="Raises specular sensitivity and suppresses more foil / glare texture noise."
                                               TextColor="#64748B"
                                               FontSize="10" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="START 5-IMAGE SURFACE SCAN"
                            Clicked="OnStartCaptureClicked"
                            HeightRequest="52"
                            CornerRadius="22"
                            BackgroundColor="#1D6A2A"
                            TextColor="#F0FFED"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Capture panel. -->
            <Grid x:Name="CapturePanel"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  Padding="14,4,14,12">

                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="2,0,2,8">
                    <Label x:Name="CaptureStepLabel"
                           Text="1 OF 5 — NEUTRAL REFERENCE"
                           TextColor="#86FF70"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label x:Name="CaptureInstructionLabel"
                           Text="First capture a neutral reference with the directional light moved away. Keep the complete card inside the guide."
                           TextColor="#CBD5E1"
                           FontSize="11" />
                </VerticalStackLayout>

                <Border Grid.Row="1"
                        Style="{StaticResource AuroraGlassBorder}"
                        Padding="8"
                        Stroke="#39FF14">
                    <Grid>
                        <toolkit:CameraView
                            x:Name="SurfaceCameraView"
                            BackgroundColor="Black"
                            CameraFlashMode="Off" />

                        <Border Margin="28"
                                Stroke="#86FF70"
                                StrokeThickness="2"
                                BackgroundColor="#08000000"
                                StrokeShape="RoundRectangle 22" />

                        <Label x:Name="TopLightMarker"
                               Text="▼ LIGHT"
                               TextColor="#39FF14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,14,0,0" />
                        <Label x:Name="RightLightMarker"
                               Text="◀ LIGHT"
                               TextColor="#64748B"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label x:Name="BottomLightMarker"
                               Text="▲ LIGHT"
                               TextColor="#64748B"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,14" />
                        <Label x:Name="LeftLightMarker"
                               Text="LIGHT ▶"
                               TextColor="#64748B"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"
                               Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Text="Restart"
                            Clicked="OnRestartClicked"
                            BackgroundColor="#253047"
                            TextColor="#E2E8F0"
                            CornerRadius="18" />
                    <Button Grid.Column="1"
                            x:Name="CaptureButton"
                            Text="CAPTURE REFERENCE"
                            Clicked="OnCaptureClicked"
                            BackgroundColor="#1D6A2A"
                            TextColor="#F0FFED"
                            FontAttributes="Bold"
                            CornerRadius="20" />
                    <Label Grid.Column="2"
                           x:Name="CapturedCountLabel"
                           Text="0/5"
                           TextColor="#9FB3C8"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Processing panel. -->
            <VerticalStackLayout x:Name="ProcessingPanel"
                                 IsVisible="False"
                                 Padding="24"
                                 Spacing="14"
                                 VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#39FF14" />
                <Label Text="Building surface map…"
                       TextColor="#F8FAFC"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Comparing directional illumination and highlighting localized surface changes."
                       TextColor="#9FB3C8"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Label Grid.Row="2"
               Text="Inspection aid only — not a professional grade."
               TextColor="#64748B"
               FontSize="10"
               HorizontalTextAlignment="Center"
               Margin="8" />
    </Grid>
</ContentPage>
