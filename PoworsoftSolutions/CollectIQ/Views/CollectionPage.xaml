<?xml version="1.0" encoding="utf-8" ?>
<!--
* FILE: CollectionPage.xaml
* PROJECT: CollectIQ (Mobile Application)
* PROGRAMMER: Darryl Poworoznyk
* FIRST VERSION: 2025-10-25
* DESCRIPTION:
*     Displays the user's sports card collection with swipe actions,
*     dynamic scrolling, and a bottom-anchored Add Card button.
*     Includes compact search + filter controls that do NOT consume
*     much screen real estate (Aurora Blue theme).
*
* NOTES:
*     - All original x:Names and click handlers are preserved.
*     - Search/filter UI is embedded in the header card so the list
*       still dominates the screen.
-->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectIQ.Views.CollectionPage"
             xmlns:controls="clr-namespace:CollectIQ.Controls"
             Title="My Collection"
             BackgroundColor="#050814">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="0">

        <!-- TOP MODE TOGGLE BAR -->
        <controls:AppModeToggleBar
            Grid.Row="0"
            Margin="0,0,0,4" />

        <!-- HEADER PANEL -->
        <Grid Grid.Row="1"
              Padding="16,10,16,0">

            <Border Style="{StaticResource AuroraGlassBorder}"
                    Padding="12,10">

                <!-- 2 columns:
                     Left = title/stats/search/filters/exports
                     Right = add button -->
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="8">

                    <!-- Title -->
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="My Collection"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F2F6FF"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />

                    <!-- Keep existing subtitle label (hidden to match reference) -->
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           x:Name="CollectionSubtitleLabel"
                           Text="Track, value, and grade your favorite cards."
                           FontSize="11"
                           TextColor="#A0AEC0"
                           IsVisible="False" />

                    <!-- Stats row -->
                    <Grid Grid.Row="1"
                          Grid.Column="0"
                          ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10"
                          VerticalOptions="Center">

                        <Label x:Name="CollectionCountLabel"
                               Grid.Column="0"
                               Text="0 Cards"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#CBD5F5"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />

                        <Label Grid.Column="1"
                               Text="·"
                               FontSize="12"
                               TextColor="#5E7A92"
                               VerticalOptions="Center" />

                        <Label x:Name="CollectionValueLabel"
                               Grid.Column="2"
                               Text="Est. Total Value: $0.00"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#7CF9FF"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </Grid>

                    <!-- SEARCH + FILTER TOGGLE (compact) -->
                    <Grid Grid.Row="2"
                          Grid.Column="0"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          RowSpacing="6">

                        <!-- Search bar -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Stroke="#1F2A44"
                                StrokeThickness="1"
                                BackgroundColor="#0E1726"
                                StrokeShape="RoundRectangle 18"
                                Padding="10,6">
                            <SearchBar x:Name="CollectionSearchBar"
                                       Placeholder="Search (player, title, set, team...)"
                                       PlaceholderColor="#5E7A92"
                                       TextColor="#E2E8F0"
                                       BackgroundColor="Transparent"
                                       FontSize="12"
                                       HeightRequest="26"
                                       TextChanged="OnSearchTextChanged" />
                        </Border>

                        <!-- Filter toggle button -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Stroke="#00E5FF"
                                StrokeThickness="1.5"
                                BackgroundColor="#16283A"
                                StrokeShape="RoundRectangle 18"
                                Padding="0"
                                VerticalOptions="Center">
                            <Button x:Name="FilterToggleButton"
                                    Text="Filter"
                                    Style="{StaticResource AuroraNeonButton}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    HeightRequest="26"
                                    FontSize="11"
                                    Padding="14,6"
                                    Clicked="OnToggleFilterPanelClicked" />
                        </Border>

                        <!-- Active filters label -->
                        <Label x:Name="ActiveFiltersLabel"
                               Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text=""
                               FontSize="11"
                               TextColor="#94A3B8"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               Margin="2,0,0,0" />

                        <!-- Collapsible filter panel -->
                        <Border x:Name="FilterPanelBorder"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsVisible="False"
                                Stroke="#1F2A44"
                                StrokeThickness="1"
                                BackgroundColor="#0E1726"
                                StrokeShape="RoundRectangle 18"
                                Padding="10"
                                Margin="0,2,0,0">

                            <VerticalStackLayout Spacing="10">

                                <!-- Compact pickers -->
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="8">

                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="Sport"
                                           FontSize="11"
                                           TextColor="#A0AEC0"
                                           VerticalOptions="Center" />
                                    <Picker x:Name="SportPicker"
                                            Grid.Row="0" Grid.Column="1"
                                            Title="Any"
                                            TextColor="#E2E8F0"
                                            BackgroundColor="Transparent"
                                            SelectedIndexChanged="OnFilterChanged" />

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="Team"
                                           FontSize="11"
                                           TextColor="#A0AEC0"
                                           VerticalOptions="Center" />
                                    <Picker x:Name="TeamPicker"
                                            Grid.Row="1" Grid.Column="1"
                                            Title="Any"
                                            TextColor="#E2E8F0"
                                            BackgroundColor="Transparent"
                                            SelectedIndexChanged="OnFilterChanged" />

                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="Set"
                                           FontSize="11"
                                           TextColor="#A0AEC0"
                                           VerticalOptions="Center" />
                                    <Picker x:Name="SetPicker"
                                            Grid.Row="2" Grid.Column="1"
                                            Title="Any"
                                            TextColor="#E2E8F0"
                                            BackgroundColor="Transparent"
                                            SelectedIndexChanged="OnFilterChanged" />
                                </Grid>

                                <!-- Clear filters -->
                                <HorizontalStackLayout Spacing="10"
                                                       HorizontalOptions="End">
                                    <Button Text="Clear"
                                            FontSize="11"
                                            TextColor="#E2E8F0"
                                            BackgroundColor="#142334"
                                            CornerRadius="14"
                                            Padding="14,8"
                                            Clicked="OnClearFiltersClicked" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- Export buttons -->
                    <HorizontalStackLayout Grid.Row="3"
                                           Grid.Column="0"
                                           Spacing="10"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center">

                        <Border Stroke="#00E5FF"
                                StrokeThickness="1.5"
                                BackgroundColor="#16283A"
                                StrokeShape="RoundRectangle 18"
                                Padding="0">
                            <Button Text="Export to Excel"
                                    Style="{StaticResource AuroraNeonButton}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    HeightRequest="26"
                                    FontSize="11"
                                    Padding="14,6"
                                    Clicked="OnExportExcelClicked" />
                        </Border>

                        <Border Stroke="#00E5FF"
                                StrokeThickness="1.5"
                                BackgroundColor="#16283A"
                                StrokeShape="RoundRectangle 18"
                                Padding="0">
                            <Button Text="Export to PDF"
                                    Style="{StaticResource AuroraNeonButton}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    HeightRequest="26"
                                    FontSize="11"
                                    Padding="14,6"
                                    Clicked="OnExportPdfClicked" />
                        </Border>

                        <!-- Add button on right -->
                        <Border 
                            Stroke="#7CF9FF"
                            StrokeThickness="1.5"
                            BackgroundColor="#142334"
                            StrokeShape="RoundRectangle 16"
                            Padding="0"
                            VerticalOptions="Center"
                            HorizontalOptions="End">

                            <Button Style="{StaticResource AuroraNeonRoundIconButton}"
                                ImageSource="add_icon.png"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                HeightRequest="26"
                                WidthRequest="26"
                                CornerRadius="16"
                                Padding="0"
                                Margin="0"
                                Clicked="OnAddCardClicked" />
                        </Border>

                    </HorizontalStackLayout>

                </Grid>
            </Border>
        </Grid>

        <!-- SCROLLABLE COLLECTION -->
        <CollectionView x:Name="CardsCollectionView"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        VerticalOptions="FillAndExpand"
                        SelectionMode="None"
                        ItemsSource="{Binding Cards}"
                        ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Label x:Name="EmptyMessage"
                       Text="Your saved cards will appear here once added."
                       TextColor="#7C8A93"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="CenterAndExpand"
                       Margin="24,40,24,0" />
            </CollectionView.EmptyView>

            <!-- ITEM TEMPLATE (UNCHANGED) -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">

                                <!-- DELETE -->
                                <SwipeItem Text="Delete"
                                           BackgroundColor="#260000"
                                           IconImageSource="delete_icon_red.png"
                                           CommandParameter="{Binding .}"
                                           Invoked="OnDeleteCard" />

                                <!-- EDIT -->
                                <SwipeItem Text="Edit"
                                           BackgroundColor="#002600"
                                           IconImageSource="edit_icon_green.png"
                                           CommandParameter="{Binding .}"
                                           Invoked="OnEditCard" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- CARD ITEM (Aurora glass card style) -->
                        <Border Style="{StaticResource AuroraGlassBorder}"
                                Margin="16,6,16,0"
                                Padding="10">

                            <Grid ColumnDefinitions="80,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10">

                                <!-- CARD IMAGE -->
                                <Border Grid.RowSpan="3"
                                        Grid.Column="0"
                                        StrokeThickness="0"
                                        Background="#0E1115"
                                        StrokeShape="RoundRectangle 8">
                                    <Image Source="{Binding FrontImagePath}"
                                           WidthRequest="72"
                                           HeightRequest="100"
                                           Aspect="AspectFill"
                                           Opacity="0.97" />
                                </Border>

                                <!-- LINE 1: PLAYER NAME -->
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#F2F6FF"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <!-- EST. VALUE CHIP (unchanged) -->
                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#132A3F">
                                    <HorizontalStackLayout Spacing="4"
                                                           VerticalOptions="Center">
                                        <Label Text="Est."
                                               FontSize="10"
                                               TextColor="#A0AEC0" />
                                        <Label Text="{Binding EstimatedValue, StringFormat='${0:F2}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#7CF9FF" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- LINE 2: SET · #NUMBER -->
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       FontSize="12"
                                       TextColor="#A0AEC0"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Set}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Number, StringFormat='# {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- LINE 3 LEFT: TEAM · SPORT · YEAR -->
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       FontSize="11"
                                       TextColor="#7C8A93"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TeamName}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding SportName}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Year}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- LINE 3 RIGHT: GRADE (unchanged) -->
                                <Label Grid.Row="2"
                                       Grid.Column="2"
                                       FontSize="11"
                                       TextColor="#CBD5F5"
                                       HorizontalTextAlignment="End"
                                       HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding GradeCompany}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Grade}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                            </Grid>
                        </Border>

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Gradient footer + nav bar -->
        <Grid Grid.Row="3"
              HeightRequest="90">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00050814" Offset="0.0" />
                    <GradientStop Color="#FF050814" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <controls:FuturisticNavBar
                Margin="0,4,0,0"
                VerticalOptions="End" />
        </Grid>

    </Grid>
</ContentPage>
